+#[allow(clippy::unwrap_used)]
+mod phase_c_tests {
+    use super::super::tests::{ORACLE_ELC2, named_objects};
+    use super::*;
+
+    fn run2(name: &str, args: &[Value]) -> Result<Value, LispError> {
+        let mut interp = Interpreter::new();
+        let mut env = Env::new();
+        let object = named_objects(ORACLE_ELC2)
