+/// The cases `invoke_subr' answers at the GNU word ABI, found once for each
+/// subr from its name; the name was compared against every case on each
+/// call from native code.
+#[derive(Clone, Copy, PartialEq, Eq)]
+enum SubrKind {
+    Other,
+    Null,
+    Consp,
+    Atom,
+    BareSymbolP,
+    Stringp,
+    Car,
+    CarSafe,
+    Cdr,
+    CdrSafe,
+    Listp,
+    Nlistp,
+    Identity,
+    Funcall,
+    Lt,
+    Gt,
+    Le,
+    Ge,
+    NumEq,
+    Plus,
+    Minus,
+    Cons,
+    Eq,
+    Symbolp,
+    TypeOf,
+    SymbolValue,
+    Assq,
+    Memq,
+    Get,
+    Apply,
+    Mapcar,
+    Maphash,
+    Nreverse,
+    Length,
+    PlistMember,
+    MakeClosure,
+    List,
+}
+
+impl SubrKind {
+    fn of(name: &str) -> Self {
+        match name {
+            "null" => Self::Null,
+            "consp" => Self::Consp,
+            "atom" => Self::Atom,
+            "bare-symbol-p" => Self::BareSymbolP,
+            "stringp" => Self::Stringp,
+            "car" => Self::Car,
+            "car-safe" => Self::CarSafe,
+            "cdr" => Self::Cdr,
+            "cdr-safe" => Self::CdrSafe,
+            "listp" => Self::Listp,
+            "nlistp" => Self::Nlistp,
+            "identity" => Self::Identity,
+            "funcall" => Self::Funcall,
+            "<" => Self::Lt,
+            ">" => Self::Gt,
+            "<=" => Self::Le,
+            ">=" => Self::Ge,
+            "=" => Self::NumEq,
+            "+" => Self::Plus,
+            "-" => Self::Minus,
+            "cons" => Self::Cons,
+            "eq" => Self::Eq,
+            "symbolp" => Self::Symbolp,
+            "type-of" => Self::TypeOf,
+            "symbol-value" => Self::SymbolValue,
+            "assq" => Self::Assq,
+            "memq" => Self::Memq,
+            "get" => Self::Get,
+            "apply" => Self::Apply,
+            "mapcar" => Self::Mapcar,
+            "maphash" => Self::Maphash,
+            "nreverse" => Self::Nreverse,
+            "length" => Self::Length,
+            "plist-member" => Self::PlistMember,
+            "make-closure" => Self::MakeClosure,
+            "list" => Self::List,
+            _ => Self::Other,
+        }
+    }
+}
+
+fn subr_kind(index: usize) -> Option<SubrKind> {
+    static KINDS: OnceLock<Box<[SubrKind]>> = OnceLock::new();
+    KINDS
+        .get_or_init(|| {
+            super::abi::native_subrs()
+                .iter()
+                .map(|subroutine| SubrKind::of(subroutine.name))
+                .collect()
+        })
+        .get(index)
+        .copied()
+}
