+/// Bvarref's full arm for SYMBOL, NAME's cell, whose value is not plain:
+/// find_symbol_value (`symbol_value_cell_symbol'), which runs no Lisp,
+/// and void-variable with NAME itself.
+#[inline(never)]
+fn varref_in_place(
+    interp: &mut Interpreter,
+    symbol: crate::lisp::types::SymbolName,
+    name: Value,
+) -> Result<Value, LispError> {
+    match interp.symbol_value_cell_symbol(&symbol) {
+        Ok(value) => Ok(value),
+        Err(error) if matches!(error.kind(), LispErrorKind::Void(_)) => {
+            Err(LispError::SignalValue(Value::list([
+                Value::symbol("void-variable"),
+                name,
+            ])))
+        }
+        Err(error) => Err(error),
+    }
+}
