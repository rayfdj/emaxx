+        eval_str_with(
+            &mut second,
+            "(get-text-property 0 'owner (symbol-name 'constructed-owner))"
+        ),
+        Value::Nil
+    );
+    eval_str_with(&mut second, "(garbage-collect)");
+    assert_eq!(
+        eval_str_with(
+            &mut first,
+            "(eq (get-text-property 0 'owner (symbol-name constructed-owner))
+                 constructed-owner)"
+        ),
+        Value::T
+    );
