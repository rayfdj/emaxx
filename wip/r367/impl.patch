+#[test]
+fn nil_and_t_are_symbols_the_lexical_environment_binds() {
+    // eval.c:eval_sub does `Fassq (form, Vinternal_interpreter_environment)'
+    // for any symbol form, `nil' and `t' among them, before
+    // Fsymbol_value; Fsetq asks the same Fassq before Fset; and a
+    // fixed-arity subr's positions past its argument list are `eval_sub
+    // (Fcar (args_left))', a reference to `nil'.  The two symbols' words
+    // are no cell's address (0 and 48), so the walk compares the words
+    // themselves and Fassq by the symbol in hand finds the same conses.
+    let mut interp = gnu_early_lisp_interpreter();
+    let read = |interp: &mut Interpreter, source: &str| {
+        let form = Reader::new(source)
+            .read()
+            .expect("the form reads")
+            .expect("one form");
+        interp.intern_symbols_in_value(&form);
+        form
+    };
+    let nil = crate::lisp::types::symbols::builtin_boolean(false);
+    let t = crate::lisp::types::symbols::builtin_boolean(true);
+    // funcall_lambda's and internal_lisp_condition_case's `Fcons (Fcons
+    // (var, val), lexenv)': `((nil . 3) (t . 4))'.
+    let mut env = Env::from_vec(vec![crate::lisp::types::EnvFrame::bindings(
+        [(t, Value::Integer(4)), (nil, Value::Integer(3))],
+        &Value::Nil,
+    )]);
+    let environment = crate::lisp::types::current_environment_value(&env);
+    assert_eq!(
+        interp.eval(&Value::Nil, &mut env).ok(),
+        Some(Value::Integer(3))
+    );
+    assert_eq!(
+        interp.eval(&Value::T, &mut env).ok(),
+        Some(Value::Integer(4))
+    );
+    for (symbol, value) in [(nil, 3), (t, 4)] {
+        let binding = crate::lisp::types::assq_binding(&environment, &symbol)
+            .expect("a proper environment")
+            .expect("the symbol is bound there");
+        assert_eq!(binding.cdr.get(), Value::Integer(value));
+    }
+    // With no environment (dynamic binding) Fassq walks nothing and the
+    // symbols are their values.
+    let mut dynamic = Env::new();
+    assert_eq!(
+        interp.eval(&Value::Nil, &mut dynamic).ok(),
+        Some(Value::Nil)
+    );
+    assert_eq!(interp.eval(&Value::T, &mut dynamic).ok(), Some(Value::T));
+    // An omitted argument is `nil' evaluated for a subr called from a
+    // form, and nothing evaluated where funcall_subr pads the call.
+    for (source, expected) in [
+        ("(substring \"abcdef\" 1)", "bc"),
+        ("(funcall 'substring \"abcdef\" 1)", "bcdef"),
+        ("(substring \"abcdef\" 1 nil)", "bc"),
+    ] {
+        let form = read(&mut interp, source);
+        let value = interp.eval(&form, &mut env).expect("the call evaluates");
+        assert_string_value(value, expected);
+    }
+    let form = read(&mut interp, "(substring \"abcdef\" 1)");
+    let value = interp
+        .eval(&form, &mut dynamic)
+        .expect("the call evaluates");
+    assert_string_value(value, "bcdef");
+    // Fsetq: XSETCDR on the lexical binding; only without one does Fset
+    // meet the constant.
+    let form = read(&mut interp, "(setq nil 7 t 8)");
+    assert_eq!(interp.eval(&form, &mut env).ok(), Some(Value::Integer(8)));
+    for (symbol, value) in [(nil, 7), (t, 8)] {
+        let binding = crate::lisp::types::assq_binding(&environment, &symbol)
+            .expect("a proper environment")
+            .expect("the symbol is bound there");
+        assert_eq!(binding.cdr.get(), Value::Integer(value));
+    }
+    let error = interp
+        .eval(&form, &mut dynamic)
+        .expect_err("Fset of a constant signals");
+    assert_eq!(error.condition_type(), "setting-constant");
+    // C reads the symbols themselves.
+    assert_eq!(interp.symbol_value("nil"), Some(Value::Nil));
+    assert_eq!(interp.symbol_value("t"), Some(Value::T));
+    // Fassq's CHECK_LIST_END: an environment that is no list signals for
+    // `nil' and `t' as for any symbol it does not find.
+    let mut improper = Env::from_vec(vec![crate::lisp::types::EnvFrame::from_alist(Value::cons(
+        Value::cons(Value::symbol("zz-improper"), Value::Integer(1)),
+        Value::Integer(5),
+    ))]);
+    for form in [Value::Nil, Value::T] {
+        let error = interp
+            .eval(&form, &mut improper)
+            .expect_err("Fassq signals listp");
+        assert_eq!(error.condition_type(), "wrong-type-argument");
+    }
+    assert_eq!(
+        interp
+            .eval(&Value::symbol("zz-improper"), &mut improper)
+            .ok(),
+        Some(Value::Integer(1))
+    );
+}
