+(finish)"##,
+    );
+    let expected = corpus.run_tty(&oracle(), &probe, "echo364.out", "C.UTF-8", &[]);
+    let actual = corpus.run_tty(emaxx(), &probe, "echo364.out", "C.UTF-8", &[]);
