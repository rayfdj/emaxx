+  (prin1 (nreverse acc)))
+(let ((s (copy-sequence "abcdéf")) (acc nil))
+  (princ s (lambda (c) (push c acc) (when (= c ?b) (aset s 4 ?e))))
+  (prin1 (nreverse acc)))"##,
