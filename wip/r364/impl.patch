+ (let ((s (copy-sequence "abcdef")) (out nil))
+   (princ s (lambda (c) (push c out) (when (eq c ?b) (aset s 4 ?X))))
+   (concat (reverse out)))
+ (let ((s (copy-sequence "abcdef")) (out nil))
+   (prin1 s (lambda (c) (push c out) (when (eq c ?b) (aset s 4 ?X))))
