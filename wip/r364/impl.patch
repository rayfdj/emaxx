+/// `DISP_TABLE_P (Vstandard_display_table)'.
+fn standard_display_table_p(interp: &Interpreter) -> bool {
+    matches!(
+        interp
+            .symbol_value_key(cached_symbol!("standard-display-table"))
+            .map(|value| value.kind()),
