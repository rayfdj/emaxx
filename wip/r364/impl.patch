+(message "m4")
+(message "%S" (condition-case err (let ((coding-system-for-write 'nosuch-coding-zz)) (prin1 (intern "\u00e9"))) (error err)))
+(message "m5")
+(message "%S" (terpri nil t))"##,
+        ),
