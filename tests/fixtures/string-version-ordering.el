(let ((cases (list (cons 'empty "") (cons 'dot ".") (cons 'dotdot "..")
                   (cons 'hidden ".renamed") (cons 'base "pkg")
                   (cons 'prerelease "pkg~rc") (cons 'zero "pkg0")
                   (cons 'one "pkg1") (cons 'one-zero "pkg01")
                   (cons 'one-more-zeros "pkg0001") (cons 'two "pkg2")
                   (cons 'twelve "pkg12") (cons 'suffix "pkg.tar.gz")
                   (cons 'version-suffix "pkg1.tar.gz")
                   (cons 'other-suffix "pkg1.tar.xz")
                   (cons 'numeric-prefix "1pkg") (cons 'zero-prefix "01pkg")
                   (cons 'long-number (concat "pkg" (make-string 96 ?9)))
                   (cons 'long-zero-number (concat "pkg000" (make-string 96 ?9)))
                   (cons 'embedded-nul (concat "pkg" (string 0) "1"))))
      (result nil))
  (dolist (left cases)
    (dolist (right cases)
      (push (list (car left) (car right)
                  (string-version-lessp (cdr left) (cdr right)))
            result)))
  (nreverse result))
