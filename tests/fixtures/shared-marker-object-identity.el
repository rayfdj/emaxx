;;; -*- lexical-binding: t; -*-
(progn
  (require 'bytecomp)
  (let* ((first (generate-new-buffer " marker-authority-a"))
         (second (generate-new-buffer " marker-authority-b"))
         (fresh (make-marker))
         (read-position (byte-compile '(lambda (marker) (marker-position marker))))
         (set-position (byte-compile '(lambda (marker position buffer)
                                        (set-marker marker position buffer))))
         (results nil))
    (unwind-protect
        (progn
          (push (list (marker-position fresh) (marker-last-position fresh)) results)
          (with-current-buffer first
            (insert "aé日xyz")
            (let* ((mark (mark-marker))
                   (ordinary (copy-marker 3))
                   (advanced (copy-marker ordinary t))
                   (sharing (vector ordinary ordinary)))
              (funcall set-position mark 3 first)
              (push (eq (set-marker-insertion-type advanced 'advance) 'advance) results)
              (goto-char 3)
              (insert "λ")
              (garbage-collect)
              (push (list (funcall read-position ordinary)
                          (marker-position advanced)
                          (mark t)
                          (eq (aref sharing 0) (aref sharing 1))) results)
              (goto-char 3)
              (insert-before-markers "Z")
              (push (list (marker-position ordinary) (mark t)
                          (marker-position advanced)) results)
              (narrow-to-region 5 7)
              (save-restriction (widen))
              (push (list (marker-position ordinary) (mark t)) results)
              (widen)
              (with-current-buffer second
                (insert "123456789")
                ;; BUFFER defaults to the current buffer even when POSITION
                ;; is a marker into another buffer.
                (set-marker fresh ordinary)
                (push (eq (marker-buffer fresh) second) results)
                (buffer-swap-text first))
              (push (list (eq (marker-buffer ordinary) second)
                          (with-current-buffer second (eq mark (mark-marker)))) results)
              (set-marker ordinary nil)
              (set-marker advanced nil)
              (let ((table (make-hash-table :test 'equal)))
                (puthash ordinary 'detached table)
                (push (list (equal ordinary advanced)
                            (gethash advanced table)) results))
              (kill-buffer second)
              (push (list (marker-position mark) (marker-last-position mark)) results)
              (push (condition-case error
                        (progn (set-marker ordinary nil "bad-buffer") nil)
                      (wrong-type-argument (eq (cadr error) 'bufferp))) results)))
          (let* ((owner (generate-new-buffer " marker-owner"))
                 (target (generate-new-buffer " marker-target"))
                 (marker (with-current-buffer owner (mark-marker))))
            (unwind-protect
                (progn
                  (with-current-buffer target (insert "abc"))
                  (set-marker marker 2 target)
                  (kill-buffer owner)
                  (push (list (eq (marker-buffer marker) target)
                              (marker-position marker)
                              (marker-last-position marker)) results))
              (when (buffer-live-p owner) (kill-buffer owner))
              (when (buffer-live-p target) (kill-buffer target))))
          (let ((saved (list (make-marker) (make-marker))))
            (set-match-data saved t)
            (push (list (match-data t) saved) results))
          (nreverse results))
      (when (buffer-live-p first) (kill-buffer first))
      (when (buffer-live-p second) (kill-buffer second)))))
