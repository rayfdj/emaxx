(mapcar
 (lambda (kind)
   (let* ((key (cond ((eq kind 'string) (copy-sequence "first-key"))
                     ((eq kind 'vector) (vector 102 105 114))
                     (t (list 102 105 114))))
          (table (make-hash-table :test 'equal :size 8)))
     (puthash key 'kept table)
     (if (eq kind 'list) (setcar key 120) (aset key 0 120))
     (let* ((copy (copy-hash-table table))
            (shared nil)
            (misses (list (gethash key table 'absent)
                          (gethash key copy 'absent))))
       (maphash (lambda (stored _value) (setq shared (eq stored key))) copy)
       (if (eq kind 'list) (setcar key 102) (aset key 0 102))
       (append misses
               (list (hash-table-count table) (hash-table-count copy)
                     shared (gethash key table) (gethash key copy)
                     (= (hash-table-size table) (hash-table-size copy)))))))
 '(string vector list))
