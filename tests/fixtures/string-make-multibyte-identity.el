(let* ((wide (propertize (string 945 946) 'conversion-probe 3))
       (ascii (propertize (string 65 66) 'conversion-probe 5))
       (bytes (propertize (unibyte-string 65 192) 'conversion-probe 7))
       (converted (string-make-multibyte bytes)))
  (list (eq wide (string-make-multibyte wide))
        (eq ascii (string-make-multibyte ascii))
        (multibyte-string-p converted)
        (string-to-list converted)
        (get-text-property 0 'conversion-probe converted)
        (get-text-property 0 'conversion-probe bytes)))
