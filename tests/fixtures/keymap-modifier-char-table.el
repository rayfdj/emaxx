(let ((map (make-keymap)) (parent (make-keymap)))
  (set-keymap-parent map parent)
  (define-key map [97] 'plain)
  (mapcar (lambda (bit)
            (let* ((event (logior 97 (lsh 1 bit))) (key (vector event)))
              (define-key parent key 'inherited)
              (let ((before (lookup-key map key)))
                (define-key map key 'modified)
                (list bit before (lookup-key map key)
                      (equal (where-is-internal 'modified map t) key)
                      (progn (define-key map key nil t) (lookup-key map key))
                      (lookup-key map [97]) (aref (cadr map) 97)))))
          '(22 23 24 25 26 27)))
