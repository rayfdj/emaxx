(let ((texts (list "" "abcd" "a\nb\n" "a\nb" "a\rb\n" "a\r\nb\r\n"
                   (string 97 11 98 12 99 133 100 8232 101 8233 102 10 103)
                   (concat (string 233 9 20013) "\n" (string 233 13 20013) "\n")
                   (concat (make-string 1023 233) "\r\n"
                           (make-string 1025 120) "\n" (string 8232) "tail")
                   (concat (make-string 8193 120) "\nend")))
      (serial 0)
      rows)
  (dolist (text texts)
    (with-temp-buffer
      (insert text)
      (dolist (edit '(original edited))
        (widen)
        (when (eq edit 'edited)
          (goto-char (+ 1 (/ (buffer-size) 2)))
          (insert (string 13 10 233 8232 10))
          (goto-char 1)
          (delete-region (point) (min (point-max) (+ (point) 2))))
        (dolist (restriction '(wide narrow))
          (widen)
          (when (eq restriction 'narrow)
            (let ((beg (min (point-max) 2)))
              (narrow-to-region beg (max beg (1- (point-max))))))
          (let* ((beg (point-min)) (end (point-max))
                 (positions
                  (if (< (- end beg) 80)
                      (number-sequence beg end)
                    (delete-dups
                     (mapcar (lambda (pos) (min end (max beg pos)))
                             (list beg (1+ beg) 1023 1024 1025 1026 1027
                                   2048 2049 2050 2051 2052
                                   (/ (+ beg end) 2) (1- end) end))))))
            (dolist (pos positions)
              (goto-char pos)
              (let ((bol (line-beginning-position))
                    (eol (line-end-position))
                    (relative (line-number-at-pos))
                    (absolute (line-number-at-pos nil t))
                    motions)
                (dolist (count '(-2 -1 0 1 2))
                  (goto-char pos)
                  (let ((shortage (forward-line count)))
                    (push (list count shortage (point)) motions)))
                (goto-char pos)
                (push (list serial edit restriction beg end pos bol eol
                            relative absolute (nreverse motions) (point))
                      rows))))))
      (setq serial (1+ serial))))
  (list (length rows) (nreverse rows)))
