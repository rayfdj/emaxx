(progn
  (defun symbol-history-fill (weak)
    (let ((alias (make-symbol "history-alias"))
          (target (make-symbol "history-target")))
      (set target (vector 137))
      (defvaralias alias target)
      (puthash alias t weak)
      (puthash target t weak)
      (list (eq (car current-load-list) alias)
            (eq (indirect-variable alias) target))))
  (let ((current-load-list nil)
        (weak (make-hash-table :test 'eq :weakness 'key))
        results)
    (push (symbol-history-fill weak) results)
    (garbage-collect)
    (garbage-collect)
    (push (hash-table-count weak) results)
    ;; The history entry roots the alias; the alias field roots its target.
    ;; Removing that actual Lisp root must allow both objects to be reclaimed.
    (setq current-load-list nil)
    (garbage-collect)
    (garbage-collect)
    (push (hash-table-count weak) results)
    (nreverse results)))
