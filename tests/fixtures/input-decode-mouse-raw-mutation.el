(let ((mouse-1-click-follows-link nil))
  (mapcar
   (lambda (head)
     (let* ((input-decode-map (make-sparse-keymap))
            (local-function-key-map (make-sparse-keymap))
            (key-translation-map (make-sparse-keymap))
            (overriding-local-map (make-sparse-keymap))
            (position (list nil 'mode-line '(7 . 2) 0))
            (event (list head position))
            (unread-command-events (list event))
            (trace nil))
       (put head 'event-kind 'mouse-click)
       (put 'reader-translated-click 'event-kind 'mouse-click)
       (define-key overriding-local-map [mode-line reader-translated-click] 'ignore)
       (define-key key-translation-map (vector head)
         (lambda (_prompt)
           (push (list (eq event last-input-event)
                       current-key-remap-sequence) trace)
           (setcar last-input-event 'reader-translated-click)
           (garbage-collect)
           (vector last-input-event)))
       (let* ((keys (read-key-sequence-vector nil))
              (raw (this-single-command-raw-keys)))
         (list keys raw
               (eq event (aref keys 1))
               (eq event (aref raw 0))
               (eq (cadr event) (cadr (aref raw 0)))
               trace))))
   '(mouse-1 reader-original-click)))
