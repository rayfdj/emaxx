(let ((cases
       (list
        (list 'whole (list "abc" nil nil "abc" nil nil))
        (list 'slice (list "0abc9" 1 -1 "abc" nil nil))
        (list 'positive-end-clamped (list "abc" nil 99 "abc" nil 100))
        (list 'negative-end-past-beginning (list "abc" nil -4 "abc" nil nil))
        (list 'right-negative-end-past-beginning (list "abc" nil nil "abc" nil -4))
        (list 'left-start-too-large (list "abc" 4 nil "abc" nil nil))
        (list 'left-start-too-negative (list "abc" -4 nil "abc" nil nil))
        (list 'reversed-left-bounds (list "abc" 2 1 "abc" nil nil))
        (list 'reversed-right-bounds (list "abc" nil nil "abc" 2 1))
        (list 'right-type-before-left-start (list "abc" 'bad nil 23 nil nil))
        (list 'right-type-before-left-end (list "abc" nil 'bad 23 nil nil))
        (list 'right-type-before-left-range (list "abc" -4 nil 23 nil nil))
        (list 'left-type-first (list 17 'bad nil 23 nil nil))
        (list 'end-type-before-start-range (list "abc" 4 'bad "abc" nil nil))
        (list 'left-index-type-first (list "abc" 'bad 'worse "abc" nil nil))
        (list 'right-end-type-before-start-range (list "abc" nil nil "abc" 4 'bad))
        (list 'symbol-is-not-string (list 'abc nil nil "abc" nil nil))
        (list 'bignum-end-is-not-fixnum
              (list "abc" nil (1+ most-positive-fixnum) "abc" nil nil))
        (list 'empty-at-end (list "abc" 3 3 "" nil nil))
        (list 'left-prefix (list "ab" nil nil "abc" nil nil))
        (list 'right-prefix (list "abc" nil nil "ab" nil nil))
        (list 'different-at-third (list "abz" nil nil "abc" nil nil))))
      (result nil))
  (dolist (entry cases)
    (push (list (car entry)
                (condition-case err
                    (apply #'compare-strings (cadr entry))
                  (error (list 'error err))))
          result))
  (nreverse result))
