(list
 (mapcar
  (lambda (case)
    (let* ((code (car case))
           (force (cadr case))
           (leaf (vector code force))
           (candidate (concat (make-string 1 code force) "one"))
           (other (concat (make-string 1 code force) "only"))
           (table (list candidate other)))
      (put-text-property 0 (length candidate) 'payload leaf candidate)
      (let ((result (try-completion "" table
                                    (lambda (_candidate) (garbage-collect) t))))
        (list (append result nil) (string-bytes result)
              (multibyte-string-p result) (eq result candidate)
              (eq (get-text-property 0 'payload result) leaf)
              (progn (aset result 0 65) (= (aref candidate 0) code))))))
  '((65 nil) (65 t) (233 nil) (955 nil) (23494 nil)
    (55296 nil) (1114111 nil) (1114112 nil) (4194176 nil) (4194303 nil)))
 (let* ((completion-ignore-case t)
        (input (propertize "A" 'payload 'input))
        (result (try-completion input '("alpha" "alpine" "amber"))))
   (list (eq result input) (get-text-property 0 'payload result)
         (append result nil) (multibyte-string-p result)))
 (let ((completion-ignore-case t))
   (mapcar
    (lambda (case)
      (let* ((input (car case))
             (first (propertize (copy-sequence (cadr case)) 'payload 'first))
             (second (propertize (copy-sequence (caddr case)) 'payload 'second))
             (result (try-completion input (list first second))))
        (if (stringp result)
            (list (append result nil) (get-text-property 0 'payload result)
                  (eq result input) (eq result first) (eq result second))
          result)))
    '(("a" "aB" "Ab") ("A" "ab" "AB") ("AL" "alpha" "ALPHA")
      ("Alpha" "Alpha" "Alpha") ("al" "AL" "alpha"))))
 (let* ((first (concat (unibyte-string 255) "one"))
        (second (concat (unibyte-string 255) "only"))
        (result (try-completion "" (list first second))))
   (list (append result nil) (string-bytes result) (multibyte-string-p result)))
 (stringp (regexp-opt '("密码" "密钥" "英语") t)))
