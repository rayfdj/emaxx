(let* ((high (make-sparse-keymap))
       (low (make-sparse-keymap))
       (last (make-sparse-keymap))
       (high-prefix (make-sparse-keymap))
       (low-prefix (make-sparse-keymap))
       (last-prefix (make-sparse-keymap))
       (parent (make-keymap))
       (child (make-keymap))
       answers)
  (define-key high-prefix [own] 'high-command)
  (define-key low-prefix [leaf] 'low-command)
  (define-key last-prefix [leaf] 'last-command)
  (define-key low [entry] low-prefix)
  (define-key last [entry] last-prefix)
  (define-key high [entry] 'stop)
  (push (lookup-key (list high low) [entry leaf]) answers)
  (define-key high [entry] high-prefix)
  (define-key low [entry] 'stop)
  (push (lookup-key (list high low last) [entry leaf]) answers)
  (define-key low [entry] nil)
  (push (lookup-key (list high low last) [entry leaf]) answers)
  (define-key high [entry] nil)
  (set-keymap-parent high last)
  (push (lookup-key high [entry leaf]) answers)
  (push (lookup-key (list high last) [entry leaf]) answers)
  (define-key parent [97] 'inherited)
  (set-keymap-parent child parent)
  (push (lookup-key child [97]) answers)
  (define-key child [97] nil)
  (push (lookup-key child [97]) answers)
  (define-key child [t] 'fallback)
  (push (list (lookup-key child [98])
              (lookup-key child [98] t)
              (lookup-key child [97] t)) answers)
  (push (list (lookup-key nil []) (lookup-key nil [entry])
              (lookup-key nil [entry tail])) answers)
  (nreverse answers))
