(progn
  (defvar hash-purecopy-calls 0)
  (define-hash-table-test 'hash-purecopy-test
    (lambda (a b) (equal a b))
    (lambda (key) (setq hash-purecopy-calls (1+ hash-purecopy-calls)) (car key)))
  (let* ((hash-purecopy-calls 0)
         (key (list 7)) (second (list 9))
         (table (make-hash-table :test 'hash-purecopy-test :size 2 :purecopy t)))
    (puthash key (list 'payload) table)
    (puthash second 'hole table)
    (setcar key 13)
    (let* ((calls hash-purecopy-calls)
           (pure (let ((purify-flag t)) (purecopy table)))
           (untouched (= calls hash-purecopy-calls))
           (copy (copy-hash-table pure))
           (new-key (list 11)) (keys nil) (copied-key nil))
      (maphash (lambda (k value) (if (consp value) (setq copied-key k))) pure)
      (puthash new-key 'new copy)
      (maphash (lambda (k _v) (setq keys (cons k keys))) copy)
      (list untouched (eq key copied-key) (equal key copied-key)
            (equal (internal--hash-table-buckets table)
                   (internal--hash-table-buckets pure))
            (hash-table-count pure) (hash-table-size pure)
            (nreverse keys)
            (condition-case error
                (progn (puthash (list 17) 'blocked pure) 'unexpected)
              (error (car error)))))))
