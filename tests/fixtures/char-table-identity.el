;;; -*- lexical-binding: t; -*-
(list
 (let* ((purpose (make-symbol "char-table-purpose"))
        (_ (put purpose 'char-table-extra-slots 2))
        (table (make-char-table purpose 'initial))
        (parent (make-char-table purpose 'parent)))
   (put purpose 'char-table-extra-slots 4)
   (set-char-table-parent table parent)
   (list (char-table-extra-slot table 1)
         (condition-case e (char-table-extra-slot table 2) (error (car e)))
         (eq purpose (char-table-subtype table))
         (syntax-table-p (make-char-table (make-symbol "syntax-table")))
         (category-table-p (make-char-table (make-symbol "category-table")))
         (condition-case e (set-char-table-parent parent table) (error (car e)))
         (progn (set-char-table-range table t 'all) (aref table #x3fffff))
         (progn (set-char-table-range table '(10 . 9) 'reversed) (aref table 10))
         (condition-case e (aref table #x400000) (error (list (car e) (cadr e))))))
 (let* ((table (make-syntax-table)) (value (cons 2 nil)) mapped)
   (aset table 65 value)
   (map-char-table (lambda (key item)
                    (when (equal key 65) (setq mapped item))) table)
   (list (eq value (aref table 65))
         (eq value (char-table-range table 65))
         (eq value mapped)
         (eq (string-to-syntax "w") (string-to-syntax "w"))
         (progn (modify-syntax-entry 66 "w" table)
                (eq (aref table 66) (string-to-syntax "w")))
         (string-to-syntax "w2c")))
 (let* ((table (make-category-table))
        (doc (copy-sequence "category"))
        (set (make-category-set "aZ")))
   (define-category ?a doc table)
   (modify-category-entry 65 ?a table)
   (modify-category-entry 1000 ?a table)
   (let ((copy (copy-category-table table)))
     (list (bool-vector-p set) (length set) (category-set-mnemonics set)
           (length (char-table-extra-slot table 0))
           (eq doc (category-docstring ?a table))
           (eq (aref table 65) (aref table 1000))
           (hash-table-p (char-table-extra-slot table 1))
           (eq (char-table-extra-slot table 1) (char-table-extra-slot copy 1))
           (equal table copy)
           (eq (aref table 65) (aref copy 65))
           (eq (char-table-extra-slot table 0) (char-table-extra-slot copy 0))
           (with-temp-buffer (set-category-table table)
                             (eq (char-category-set 65) (aref table 65)))
           (condition-case e (modify-category-entry 65 ?b table) (error (car e))))))
 (let ((table (make-char-table nil)) snapshots saved)
   (set-char-table-range table '(1 . 3) 'a)
   (set-char-table-range table '(1000 . 1002) 'b)
   (map-char-table
    (lambda (range value)
      (push (list (if (consp range) (cons (car range) (cdr range)) range) value) snapshots)
      (when (consp range) (push range saved))
      (when (eq value 'a)
        (aset table 1001 'changed)
        (set-char-table-range table '(131072 . 131075) 'late)
        (garbage-collect)))
    table)
   (list (nreverse snapshots) (eq (car saved) (cadr saved))))
 (let ((table (make-char-table nil 'initial)))
   (aset table 65 'ascii-old)
   (fillarray table 'new)
   (list (aref table 65) (aref table 200) (char-table-range table nil)
         (aref (copy-sequence table) 65)))
 (let* ((purpose (make-symbol "self-referential-char-table"))
        (_ (put purpose 'char-table-extra-slots 1))
        (table (make-char-table purpose nil))
        (print-circle t) (print-gensym t))
   (set-char-table-extra-slot table 0 table)
   (aset table 42 (cons 'leaf table))
   (let ((read-back (read (prin1-to-string table))))
     (list (eq read-back (char-table-extra-slot read-back 0))
           (eq read-back (cdr (aref read-back 42)))
           (equal table read-back)))))
