(progn
  (require 'cl-lib)
  (defvar write-order-events nil)
  (defvar write-order-create nil)
  (defun write-order-selector (_start _end _coding &optional _interactive file)
    (push 'select write-order-events)
    (when write-order-create
      (let ((coding-system-for-write 'utf-8))
        (with-temp-file file (insert "occupied"))))
    (garbage-collect)
    'utf-8)
  (defun write-order-case (spec)
    (let* ((directory (make-temp-file "write-order-" t))
           (file (expand-file-name "state.dat" directory))
           (select-safe-coding-system-function 'write-order-selector)
           (coding-system-for-write nil)
           (coding-system-require-warning nil)
           (create-lockfiles nil)
           (inhibit-message t)
           (write-order-create (plist-get spec :create))
           (write-order-events nil))
      (unwind-protect
          (progn
            (when (plist-get spec :existing)
              (let ((coding-system-for-write 'utf-8))
                (with-temp-file file (insert "old"))))
            (let* ((last-coding-system-used 'before-write)
                   (outcome
                    (cl-letf (((symbol-function 'y-or-n-p)
                               (lambda (&rest _)
                                 (push 'confirm write-order-events)
                                 (plist-get spec :answer))))
                      (condition-case error
                          (progn
                            (write-region "new" nil file (plist-get spec :append)
                                          'silent nil (plist-get spec :must))
                            'ok)
                        (error (car error)))))
                   (used last-coding-system-used)
                   (events (nreverse write-order-events))
                   (bytes (with-temp-buffer
                            (set-buffer-multibyte nil)
                            (insert-file-contents-literally file)
                            (append (buffer-string) nil))))
              (list (plist-get spec :name) outcome used events bytes)))
        (delete-directory directory t))))
  (mapcar #'write-order-case
          '((:name decline :existing t :must t)
            (:name accept :existing t :must t :answer t)
            (:name exclusive-existing :existing t :must excl)
            (:name exclusive-callback-creation :create t :must excl)
            (:name exclusive-new :must excl)
            (:name append :existing t :append t)
            (:name offset :existing t :append 1)
            (:name exclusive-append :existing t :append t :must excl))))
