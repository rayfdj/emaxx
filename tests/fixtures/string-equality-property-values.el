(let* ((left-value (propertize "one" 'inner 'left))
       (right-value (propertize "one" 'inner 'right))
       (left (propertize "abc" 'payload left-value))
       (right (propertize "abc" 'payload right-value))
       (cases (list (cons 'no-properties (copy-sequence "abc"))
                    (cons 'plain-value (propertize "abc" 'payload "one"))
                    (cons 'left-value left) (cons 'right-value right)
                    (cons 'unibyte-value
                          (propertize "abc" 'payload (unibyte-string #x80)))
                    (cons 'byte8-value
                          (propertize "abc" 'payload (string #x3fff80)))
                    (cons 'vector-left
                          (propertize "abc" 'payload (vector left-value)))
                    (cons 'vector-right
                          (propertize "abc" 'payload (vector right-value)))))
       (matrix nil)
       (changes nil)
       (segmented (copy-sequence "abc"))
       (whole (propertize "abc" 'first 1 'second '(2 3))))
  (dolist (a cases)
    (dolist (b cases)
      (push (list (car a) (car b)
                  (equal (cdr a) (cdr b))
                  (equal-including-properties (cdr a) (cdr b))
                  (string-equal (cdr a) (cdr b)))
            matrix)))
  (push (list 'before (equal-including-properties left right)) changes)
  (put-text-property 0 3 'inner 'changed right-value)
  (push (list 'nested-properties (equal-including-properties left right)) changes)
  (aset right-value 0 ?z)
  (push (list 'nested-contents (equal-including-properties left right)) changes)
  (aset right-value 0 ?o)
  (garbage-collect)
  (push (list 'restored-after-gc (equal-including-properties left right)) changes)
  (add-text-properties 0 1 '(second (2 3) first 1) segmented)
  (add-text-properties 1 3 '(first 1 second (2 3)) segmented)
  (push (list 'segmentation-and-order
              (equal-including-properties segmented whole)) changes)
  (put-text-property 1 2 'first 9 segmented)
  (push (list 'changed-interval
              (equal-including-properties segmented whole)) changes)
  (list (nreverse matrix) (nreverse changes)))
