(let ((forms '((string)
               (make-string 0 ?a)
               (make-string 0 ?a t)
               (make-string 0 #x3b1)
               (substring "ab" 1 1)
               (substring (string #x3b1) 0 0)
               (concat)
               (concat "" "")
               (concat (make-string 0 ?a t))
               (string-as-unibyte (make-string 0 ?a t))
               (string-as-multibyte "")
               (string-to-multibyte "")))
      (result nil)
      (index 0))
  (dolist (form forms)
    (let ((first (eval form)) (second (eval form)))
      (push (list index form (length first) (string-bytes first)
                  (multibyte-string-p first) (eq first second)
                  (eq first (copy-sequence first))
                  (eq first (substring first 0 0))
                  (eq first (substring-no-properties first))
                  (eq first (concat first)))
            result))
    (setq index (1+ index)))
  (nreverse result))
