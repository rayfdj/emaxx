(list
 (mapcar
  (lambda (code)
    (let* ((source (make-string 5 code))
           (leaf (vector code))
           (before (append source nil)))
      (put-text-property 0 5 'payload leaf source)
      (put-text-property 1 4 'second 'mark source)
      (mapcar
       (lambda (function)
         (mapcar
          (lambda (bounds)
            (let* ((result (funcall function source (car bounds) (cadr bounds)))
                   (contents (append result nil)))
              (garbage-collect)
              (list contents (string-bytes result) (multibyte-string-p result)
                    (if (> (length result) 0)
                        (list (eq (get-text-property 0 'payload result) leaf)
                              (get-text-property 0 'second result)))
                    (if (> (length result) 0)
                        (progn (aset result 0 65)
                               (equal before (append source nil)))))))
          '((nil nil) (0 0) (nil 2) (1 4) (-3 -1) (4 5) (5 nil))))
       '(substring substring-no-properties))))
  '(0 127 128 55296 57343 1114112 2097152 4194175 4194176 4194303))
 (let* ((leaf (list 'original)) (source (vector leaf leaf))
        (copy (substring source 0 nil)))
   (aset copy 0 'changed)
   (garbage-collect)
   (list (vectorp copy) (eq (aref source 0) leaf)
         (eq (aref copy 1) leaf) (not (eq source copy)))))
