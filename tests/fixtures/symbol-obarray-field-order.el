(let* ((symbols (mapcar #'intern '("payload-order-janus-a" "payload-order-janus-b" "payload-order-janus-c")))
       (enumerate (lambda () (let (found) (mapatoms (lambda (symbol) (when (memq symbol symbols) (push symbol found)))) found)))
       (before (funcall enumerate)))
  (set (nth 2 symbols) 71)
  (fset (nth 0 symbols) (lambda () 73))
  (setplist (nth 1 symbols) '(payload 79))
  (makunbound (nth 2 symbols))
  (set (nth 2 symbols) 83)
  (fmakunbound (nth 0 symbols))
  (fset (nth 0 symbols) (lambda () 89))
  (let ((after (funcall enumerate)))
    (list (equal before after) (= (length after) 3)
          (eq (intern-soft "payload-order-janus-a") (nth 0 symbols))
          (eq (intern-soft "payload-order-janus-b") (nth 1 symbols))
          (eq (intern-soft "payload-order-janus-c") (nth 2 symbols))
          (= (funcall (nth 0 symbols)) 89)
          (equal (symbol-plist (nth 1 symbols)) '(payload 79))
          (= (symbol-value (nth 2 symbols)) 83))))
