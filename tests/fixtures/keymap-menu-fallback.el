(let* ((map (make-sparse-keymap))
       (other (make-sparse-keymap))
       (key [menu-bar Project\ Tools Run\ Task])
       (before (copy-sequence key))
       (language current-language-environment)
       result)
  (define-key map [menu-bar project-tools run-task] 'run-project)
  (define-key map [menu-bar project-tools 7] 'numeric-item)
  (define-key map (vector 'menu-bar (intern "åäö") (intern "γ")) 'unicode-item)
  (define-key map [project-tools run-task] 'ordinary-item)
  (define-key other [menu-bar final-item] 'other-map)
  (setq result
        (list (lookup-key map key)
              (equal key before)
              (lookup-key map [menu-bar Project-Tools 7])
              (lookup-key map (vector 'menu-bar (intern "Åäö") (intern "Γ")))
              (lookup-key map [Project-Tools Run-Task])
              (lookup-key map [menu-bar Project-Tools Run-Task extra])
              (lookup-key (list map other) [menu-bar Final-Item])))
  (define-key map key 'exact-item)
  (setq result (append result (list (lookup-key map key))))
  (define-key map key nil)
  (garbage-collect)
  (setq result (append result (list (lookup-key map key))))
  (unwind-protect
      (progn
        (set-language-environment "Turkish")
        (define-key map [menu-bar i-bar] 'unicode-case)
        (define-key map (vector 'menu-bar (intern "ı-local")) 'local-case)
        (setq result
              (append result
                      (list (lookup-key map [menu-bar I-bar])
                            (lookup-key map [menu-bar I-local])))))
    (set-language-environment language))
  result)
