(let (answers)
  (dolist (stage '(input-decode-map local-function-key-map key-translation-map))
    (dolist (events '((u v p q x y) (17 18 19 20 21 22) (f31 f32 f33 f34 f35 f36)))
      (let* ((input-decode-map (make-sparse-keymap))
             (local-function-key-map (make-sparse-keymap))
             (key-translation-map (make-sparse-keymap))
             (overriding-terminal-local-map (make-sparse-keymap))
             (translation (symbol-value stage))
             (first (nth 0 events)) (second (nth 1 events))
             (third (nth 2 events)) (fourth (nth 3 events))
             (left (nth 4 events)) (right (nth 5 events))
             (unread-command-events (list first third fourth 'stop)))
        (define-key translation (vector first second) (vector left))
        (define-key translation (vector third fourth) (vector right))
        (define-key overriding-terminal-local-map (vector left) 'ignore)
        (define-key overriding-terminal-local-map (vector right) 'ignore)
        (push (list (read-key-sequence-vector nil) unread-command-events) answers))))
  (nreverse answers))
