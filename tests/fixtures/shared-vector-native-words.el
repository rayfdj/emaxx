(progn
  (require 'comp)
  (let (results)
    (dolist (name '(shared-vector-native-hop renamed-vector-native-hop))
      (let* ((source (make-temp-file (symbol-name name) nil ".el"))
             (output (make-temp-file "shared-vector-native-output-" t))
             (comp-no-spawn nil)
             (comp-running-batch-compilation t)
             (native-comp-jit-compilation nil)
             (symbols-with-pos-enabled t)
             (valid t)
             (count 0))
        (unwind-protect
            (progn
              (with-temp-file source
                (insert ";;; -*- lexical-binding: t -*-\n")
                (prin1
                 `(defun ,name (object function replacement empty)
                    (let ((before (aref object 0)))
                      (aset object 1 replacement)
                      (garbage-collect)
                      (and (or (eq before (aref object 0))
                               (progn (message "native vector check failed: original element") nil))
                           (or (eq object (aref object 2))
                               (progn (message "native vector check failed: vector cycle") nil))
                           (or (eq function (aref object 3))
                               (progn (message "native vector check failed: closure identity") nil))
                           (or (eq (funcall function) replacement)
                               (progn (message "native vector check failed: callback result") nil))
                           (or (eq (aref object 1) replacement)
                               (progn (message "native vector check failed: stored replacement") nil))
                           (or (not (eq object empty))
                               (progn (message "native vector check failed: distinct empty vector") nil)))))
                 (current-buffer)))
              (native-elisp-load
               (native-compile source (expand-file-name "shared.eln" output)))
              (dolist (length '(4 251 252))
                (let* ((object (make-vector length nil))
                       (function
                        (make-interpreted-closure
                         nil (list (list 'aref (list 'quote object) 1)) '(t) nil)))
                  (aset object 0 (list name length))
                  (aset object 2 object)
                  (aset object 3 function)
                  (dolist (replacement
                           (list nil t 19 1.25 (concat "shared-" "text")
                                 (string-make-unibyte "bytes")
                                 (make-symbol "renamed-element") (cons 19 73)
                                 (vector 73 19) function (make-marker)
                                 (make-char-table 'shared-vector-table nil)
                                 (record 'shared-vector-record 19 73)
                                 (expt 2 75) (current-buffer)))
                    (setq count (1+ count))
                    (unless (funcall name object function replacement [])
                      (message "native vector case: name=%S length=%d case=%d type=%S"
                               name length count (type-of replacement))
                      (setq valid nil)))))
              (push (list (native-comp-function-p (symbol-function name)) valid count)
                    results))
          (fmakunbound name)
          (delete-file source)
          (delete-directory output t))))
    (nreverse results)))
