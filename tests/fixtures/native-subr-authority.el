(progn
  (require 'comp)
  (let* ((lexical-binding t)
         (native (native-compile '(lambda (first &optional second)
                                    "Collect two arguments."
                                    (interactive "p")
                                    (list first second))))
         (dynamic (let ((lexical-binding nil))
                    (native-compile '(lambda (value &optional optional)
                                       (list value optional)))))
         (worker (native-compile '(lambda (function input)
                                   (garbage-collect)
                                   (list (subrp function)
                                         (native-comp-function-p function)
                                         (funcall function input)))))
         (builtin (symbol-function 'cons))
         (table (make-hash-table :test 'equal))
         rows)
    (unless (and (native-comp-function-p native)
                 (native-comp-function-p dynamic)
                 (native-comp-function-p worker))
      (error "All three workers must execute native code"))
    (puthash native '(stored native identity) table)
    (dolist (input '(17 83))
      (garbage-collect)
      (push (list (funcall native input) (funcall worker native input)
                  (funcall dynamic input) (funcall worker dynamic input)) rows))
    (list (type-of native) (subrp native) (functionp native)
          (subr-arity native) (subr-arity dynamic)
          (subr-native-lambda-list native) (subr-native-lambda-list dynamic)
          (stringp (subr-name native)) (stringp (subr-name dynamic))
          (interactive-form native) (documentation native)
          (eq native native) (equal native native) (equal native dynamic)
          (gethash native table)
          (value< native native) (value< native dynamic)
          (value< native builtin) (value< builtin native)
          (condition-case error-data (value< native [1]) (error (car error-data)))
          (condition-case error-data (funcall native) (error (car error-data)))
          (condition-case error-data (funcall native 1 2 3) (error (car error-data)))
          (nreverse rows))))
