(mapcar
 (lambda (case)
   (let* ((text (funcall (car case)))
          (alias text)
          (original (string-to-list text))
          (marker (list 'shared-marker (length text))))
     (put-text-property 0 (min 2 (length text)) 'runtime-marker marker text)
     (let ((properties (eq (get-text-property 0 'runtime-marker alias) marker))
           (stored (aset text 0 (cadr case))))
       (garbage-collect)
       (let* ((after-store (string-to-list alias))
              (fill (condition-case error
                        (eq (fillarray text ?x) alias)
                      (error (car error))))
              (after-fill (string-to-list alias))
              (cleared (clear-string text)))
         (garbage-collect)
         (list original properties stored after-store fill after-fill cleared
               (string-to-list alias) (multibyte-string-p alias)
               (eq text alias)
               (eq (get-text-property 0 'runtime-marker alias) marker))))))
 (list (list (lambda () (number-to-string 7)) ?Z)
       (list (lambda () (number-to-string -40817)) ?Q)
       (list (lambda () (number-to-string 12345678901234567)) #x03bb)
       (list (lambda () (format "%s" "ordinary-format")) ?A)
       (list (lambda () (copy-sequence "canonical-control")) ?B)))
