(progn
 (defun detached-lifetime-check (suffix weak)
   (let* ((name (concat "detached-lifetime-" suffix))
          (old (intern name))
          new live released)
     (set old (list 17))
     (fset old (lambda () 73))
     (setplist old (list 'owner old))
     (puthash old t weak)
     (unintern old)
     (setq new (intern (copy-sequence name)))
     (puthash new t weak)
     (garbage-collect)
     (setq live (list (= (hash-table-count weak) 2)
                      (= (car (symbol-value old)) 17)
                      (= (funcall old) 73)
                      (eq (get old 'owner) old)
                      (not (boundp new))
                      (not (fboundp new))
                      (null (symbol-plist new))))
     (setq old nil)
     (garbage-collect)
     (garbage-collect)
     (setq released (= (hash-table-count weak) 1))
     (unintern new)
     (setq new nil)
     (garbage-collect)
     (garbage-collect)
     (list live released)))
 (mapcar (lambda (suffix)
           (let* ((weak (make-hash-table :test 'eq :weakness 'key))
                  (live (detached-lifetime-check suffix weak)))
             (garbage-collect)
             (garbage-collect)
             (list live (= (hash-table-count weak) 0))))
         (list "first" "λ-second")))
