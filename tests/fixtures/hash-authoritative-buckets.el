(progn
  (defvar hash-authority-code 0)
  (define-hash-table-test 'hash-authority-test
    (lambda (a b) (equal a b))
    (lambda (_key) hash-authority-code))
  (let* ((hash-authority-code 0)
         (key (list 'mutable-key))
         (other (copy-sequence key))
         (table (make-hash-table :test 'hash-authority-test :size 8))
         (identity nil) (holes nil) (buckets nil))
    (puthash key 'kept table)
    (setq hash-authority-code 13)
    (let ((copy (copy-hash-table table)))
      (setq identity (list (gethash key table 'absent)
                           (gethash other table 'absent)
                           (gethash key copy 'absent)
                           (gethash other copy 'absent))))
    (setq hash-authority-code 0)
    (clrhash table)
    (puthash 'a 1 table) (puthash 'b 2 table) (puthash 'c 3 table)
    (setq buckets (list (internal--hash-table-index-size table)
                         (internal--hash-table-histogram table)
                         (internal--hash-table-buckets table)))
    (remhash 'a table) (remhash 'b table) (remhash 'c table)
    (clrhash table)
    (puthash 'x 1 table) (puthash 'y 2 table) (puthash 'z 3 table)
    (maphash (lambda (k _v) (setq holes (cons k holes))) table)
    (list identity buckets (nreverse holes))))
