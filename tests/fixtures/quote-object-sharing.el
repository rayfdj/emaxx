(progn
  (defalias 'quote-object-alias 'quote)
  (defun quote-object-hash () '#s(hash-table test eq data (seed 1)))
  (defun quote-object-record () '#s(quote-object-record seed))
  (defun quote-object-vector () [#s(hash-table test eq data (seed 1))])
  (defun quote-object-cycle () '#1=(seed . #1#))
  (let ((buffer-source
         "(defun quote-buffer-hash () '#s(hash-table test eq data (seed 1)))\n(defun quote-buffer-record () '#s(quote-buffer-record seed))\n"))
    (with-temp-buffer
      (insert buffer-source)
      (eval-buffer)))
  (list
   (condition-case condition (eval '(quote first second)) (error condition))
   (condition-case condition
       (eval '(quote-object-alias first second)) (error condition))
   (let* ((object (list 'seed)) (form (list 'quote object)))
     (setcar object 'changed)
     (list (eq object (eval form)) (car (eval form))))
   (let ((first (quote-object-hash)) (second (quote-object-hash)))
     (puthash 'changed 19 first)
     (list (eq first second) (gethash 'changed second)))
   (let ((first (quote-object-record)) (second (quote-object-record)))
     (aset first 1 'changed)
     (list (eq first second) (aref second 1)))
   (let ((first (quote-object-vector)) (second (quote-object-vector)))
     (puthash 'changed 23 (aref first 0))
     (list (eq first second) (eq (aref first 0) (aref second 0))
           (gethash 'changed (aref second 0))))
   (let ((first (quote-object-cycle)) (second (quote-object-cycle)))
     (garbage-collect)
     (setcar first 'changed)
     (list (eq first second) (eq first (cdr first)) (car second)))
   (let ((first (quote-buffer-hash)) (second (quote-buffer-hash)))
     (puthash 'changed 29 first)
     (list (eq first second) (gethash 'changed second)))
   (let ((first (quote-buffer-record)) (second (quote-buffer-record)))
     (aset first 1 'changed)
     (list (eq first second) (aref second 1)))))
