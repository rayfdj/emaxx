(let ((cases (list (cons 'empty "")
                   (cons 'ascii-lower "e") (cons 'ascii-upper "E")
                   (cons 'byte-lower (unibyte-string #xe9))
                   (cons 'byte-upper (unibyte-string #xc9))
                   (cons 'unicode-lower (string #xe9))
                   (cons 'unicode-upper (string #xc9))
                   (cons 'byte8-lower (string #x3fffe9))
                   (cons 'byte8-upper (string #x3fffc9))
                   (cons 'private-lower (string #xe0e9))
                   (cons 'private-upper (string #xe0c9))
                   (cons 'extended (string #x110000))
                   (cons 'maximum (string #x3fffff))
                   (cons 'sigma-final (string #x3c2))
                   (cons 'sigma-upper (string #x3a3))
                   (cons 'nul-prefix (string 0 ?e))))
      (result nil))
  (dolist (buffer-multibyte '(nil t))
    (with-temp-buffer
      (set-buffer-multibyte buffer-multibyte)
      (dolist (ignore-case '(nil t))
        (dolist (left cases)
          (dolist (right cases)
            (push (list buffer-multibyte ignore-case (car left) (car right)
                        (compare-strings (cdr left) nil nil (cdr right) nil nil ignore-case))
                  result))))))
  (nreverse result))
