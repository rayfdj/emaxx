(progn
  (require 'cl-lib)
  (defvar report-mode-enabled nil)
  (defvar report-filter-visible nil)
  (let* ((source (generate-new-buffer " *binding-source*"))
         (saved (current-global-map))
         (global (make-sparse-keymap))
         (local (make-sparse-keymap))
         (minor (make-sparse-keymap))
         (overriding-terminal-local-map nil)
         (overriding-local-map nil)
         (key-translation-map nil)
         (local-function-key-map nil)
         (input-decode-map nil)
         (keyboard-translate-table nil)
         (minor-mode-map-alist `((report-mode-enabled . ,minor)))
         (minor-mode-overriding-map-alist nil)
         (emulation-mode-map-alists nil)
         results)
    (unwind-protect
        (progn
          (define-key global "x" 'global-shadowed)
          (define-key global "g" 'global-visible)
          (define-key local "x" 'local-shadowed)
          (define-key local [(48 . 57)] 'number-command)
          (define-key local "a" '(menu-item "Filtered" filtered-command
                                  :filter (lambda (command)
                                            (garbage-collect)
                                            (and report-filter-visible command))))
          (define-key local [menu-bar report action] 'menu-command)
          (define-key minor "x" 'minor-visible)
          (use-global-map global)
          (with-current-buffer source
            (use-local-map local)
            (setq-local major-mode 'report-major-mode)
            (setq-local report-mode-enabled t)
            (setq-local report-filter-visible t))
          (dolist (options '((nil nil) (nil t) ("a" nil)))
            (with-temp-buffer
              (setq-local report-filter-visible nil)
              (let ((out (current-buffer)))
                (push (list (describe-buffer-bindings source (car options) (cadr options))
                            (eq out (current-buffer))
                            (buffer-string))
                      results))))
          (push (condition-case err (describe-buffer-bindings " *binding-source*")
                  (wrong-type-argument (list (car err) (cadr err))))
                results)
          (nreverse results))
      (use-global-map saved)
      (kill-buffer source))))
