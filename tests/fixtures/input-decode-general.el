(let ((inhibit-message t))
  (list
   (mapcar
    (lambda (sequence)
      (let ((input-decode-map (make-sparse-keymap))
            (unread-command-events (append sequence '(122))))
        (define-key input-decode-map sequence [translated])
        (list (read-key) unread-command-events)))
    (list "abc" "abcdefghijk" [alpha beta gamma]))
   (let ((input-decode-map (make-sparse-keymap))
         (unread-command-events '(27 91 77 116 97 105 108))
         (seen nil))
     (define-key input-decode-map "\e[M"
       (lambda (prompt)
         (setq seen (list prompt current-key-remap-sequence))
         (garbage-collect)
         [configured]))
     (list (read-key "Choose: ") unread-command-events seen))
   (let ((input-decode-map (make-sparse-keymap))
         (unread-command-events '(112 113 122))
         (filters 0))
     (define-key input-decode-map "pq"
       (list 'menu-item "Translation" [filtered]
             :filter (lambda (translation)
                       (setq filters (1+ filters))
                       (garbage-collect)
                       translation)))
     (list (read-key) unread-command-events filters))
   (let ((input-decode-map (make-sparse-keymap))
         (unread-command-events '(112 113 122))
         (name (make-symbol "vector-decoder")))
     (fset name [aliased])
     (define-key input-decode-map "pq" name)
     (list (read-key) unread-command-events))
   (let ((input-decode-map (make-sparse-keymap))
         (unread-command-events '(112 113 122)))
     (define-key input-decode-map "pq" (lambda (_prompt) 17))
     (condition-case error
         (read-key)
       (error (list (car error) (cadr error)))))))
