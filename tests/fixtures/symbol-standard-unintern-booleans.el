(mapcar (lambda (name)
        (let* ((old (intern name))
               (removed (unintern old))
               (new (intern (copy-sequence name))))
          (list removed (not (eq old new))
                (null (intern-soft old))
                (eq (intern-soft new) new)
                (null (unintern old))
                (eq (intern-soft name) new)
                (eq (car (read-from-string name)) new)
                (not (boundp new)) (not (fboundp new)))))
        (list "nil" "t"))
