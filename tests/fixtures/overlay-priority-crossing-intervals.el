  (dolist (variant '(0 1 2 3))
    (with-temp-buffer
      (insert (make-string 120 ?x))
      (let ((index 0) objects)
        (dolist (row (if (= variant 1) (reverse data) data))
          (let ((object (make-overlay (if (= variant 2) (- 51 (car row)) (car row))
                                      (cadr row))))
            (overlay-put object 'label index)
            (overlay-put object 'priority (cons 0 (* (if (= variant 3) -1 1) (caddr row))))
            (push object objects)
            (setq index (1+ index))))
        (let* ((sorted (overlays-at 50 t))
               (labels (mapcar (lambda (o) (overlay-get o 'label)) sorted))
               (complete (equal (sort (copy-sequence labels) #'<) (number-sequence 0 63))))
          (garbage-collect)
          (let ((stable (equal labels (mapcar (lambda (o) (overlay-get o 'label)) (overlays-at 50 t)))))
            (overlay-put (car objects) 'priority '(10 . -99))
            (push (list (length sorted) complete stable (eq (car objects) (car (overlays-at 50 t)))) results))))))
  (nreverse results))
