(let ((result nil))
  (dolist (label '("buffer-object-37" " buffer object 81" "buffer-object-lambda"))
    (let* ((original-name (generate-new-buffer-name label))
           (renamed-name (generate-new-buffer-name (concat label "-renamed")))
           (buffer (get-buffer-create original-name))
           (same (get-buffer original-name))
           (table (make-hash-table :test 'eq))
           (equal-table (make-hash-table :test 'equal))
           replacement)
      (unwind-protect
          (progn
            (puthash buffer 37 table)
            (puthash buffer 81 equal-table)
            (with-current-buffer buffer
              (insert label)
              (setq result (cons (eq buffer (current-buffer)) result))
              (rename-buffer renamed-name))
            (garbage-collect)
            (setq result
                  (cons (list (eq buffer same)
                              (eq buffer (get-buffer renamed-name))
                              (eq buffer (car (memq buffer (buffer-list))))
                              (gethash same table)
                              (gethash same equal-table)
                              (with-current-buffer same (buffer-string)))
                        result))
            (kill-buffer buffer)
            (setq replacement (get-buffer-create renamed-name))
            (setq result
                  (cons (list (buffer-live-p buffer)
                              (eq buffer replacement)
                              (eq buffer (get-buffer buffer))
                              (condition-case nil
                                  (progn (set-buffer buffer) 'accepted)
                                (error 'rejected)))
                        result)))
        (when (buffer-live-p buffer) (kill-buffer buffer))
        (when (buffer-live-p replacement) (kill-buffer replacement)))))
  (nreverse result))
