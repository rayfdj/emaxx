(let ((results nil))
  (dolist (number '(7 -40817 12345678901234567))
    (let* ((holder (vector (number-to-string number)))
           (bound (aref holder 0))
           (marker (list 'vector-marker number))
           (identity (eq bound (aref holder 0))))
      (put-text-property 0 1 'runtime-marker marker (aref holder 0))
      (aset (aref holder 0) 0 ?Z)
      (garbage-collect)
      (let ((stored (string-to-list (aref holder 0)))
            (bound-stored (string-to-list bound))
            (property (eq (get-text-property 0 'runtime-marker (aref holder 0))
                          marker))
            (fill-identity (eq (fillarray (aref holder 0) ?x) (aref holder 0))))
        (let ((filled (string-to-list (aref holder 0))))
          (clear-string (aref holder 0))
          (garbage-collect)
          (push (list number identity stored bound-stored property fill-identity
                      filled (string-to-list (aref holder 0))
                      (eq (get-text-property 0 'runtime-marker (aref holder 0))
                          marker))
                results)))))
  (nreverse results))
