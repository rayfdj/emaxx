(let* ((inhibit-message t)
       (create-lockfiles nil)
       (auto-save-default nil)
       (make-backup-files nil)
       (directory (make-temp-file "file-coding-observe-" t))
       (default-directory (file-name-as-directory directory)))
  (unwind-protect
      (progn
        (with-temp-file "source.dat" (insert "source bytes\n"))
        (find-file "source.dat")
        (let ((source-coding buffer-file-coding-system))
          (find-alternate-file "missing.dat")
          (let ((new-coding buffer-file-coding-system))
            (insert "created bytes\n")
            (save-buffer)
            (let ((saved-coding buffer-file-coding-system)
                  (used last-coding-system-used)
                  (saved-buffer (current-buffer)))
              (kill-buffer saved-buffer)
              (find-file "missing.dat")
              (list source-coding new-coding saved-coding used
                    buffer-file-coding-system (buffer-string))))))
    (dolist (buffer (buffer-list))
      (when (and (buffer-file-name buffer)
                 (string-prefix-p directory (buffer-file-name buffer)))
        (kill-buffer buffer)))
    (delete-directory directory t)))
