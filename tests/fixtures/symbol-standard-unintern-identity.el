(mapcar
  (lambda (suffix)
    (let* ((name (concat "retired-obarray-" suffix))
           (old (intern name)))
      (set old 231)
      (fset old (lambda () 257))
      (setplist old (list 'token 263))
      (let* ((removed (unintern old))
             (absent (and (null (intern-soft name))
                          (null (intern-soft old))))
             (fresh-name (copy-sequence name))
             (new (intern fresh-name))
             (fresh (list (not (eq old new))
                          (not (boundp new))
                          (not (fboundp new))
                          (null (symbol-plist new))
                          (eq (symbol-name new) fresh-name)))
             (exact (list (null (intern-soft old))
                          (eq (intern-soft new) new)
                          (null (unintern old))
                          (eq (intern-soft name) new))))
        (set new 701)
        (fset new (lambda () 709))
        (setplist new (list 'token 719))
        (append (list removed absent) fresh exact
                (list (= (symbol-value old) 231)
                      (= (funcall old) 257)
                      (= (get old 'token) 263)
                      (= (symbol-value new) 701)
                      (= (funcall new) 709)
                      (= (get new 'token) 719))))))
  (list (concat "first" "-identity")
        (concat "second" "-λ")))
