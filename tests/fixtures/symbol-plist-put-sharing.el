(progn
  (defun symbol-plist-store (operation owner plist key value)
    (if (eq operation 'put)
        (put owner key value)
      (plist-put plist key value)))
  (let (results)
    (dolist (operation '(put plist-put))
      ;; Existing and appended properties share every pre-existing cons.
      (dolist (size '(1 3 17 129))
        (let ((owner (make-symbol (format "plist-owner-%s" size)))
              (key (list 'same-key)) (other-key (list 'same-key))
              (value (vector size)) plist last)
          (dotimes (i size)
            (setq plist (cons (make-symbol (format "property-%s" i))
                              (cons i plist))))
          (setcar plist key)
          (setplist owner plist)
          (setq last (last plist))
          (let ((returned (symbol-plist-store operation owner plist key value)))
            (push (list operation size (eq plist (symbol-plist owner))
                        (eq (cadr plist) value)
                        (eq returned (if (eq operation 'put) value plist)))
                  results))
          (symbol-plist-store operation owner plist other-key 'added)
          (push (list (eq plist (symbol-plist owner))
                      (= (length plist) (+ (* 2 size) 2))
                      (eq (car (cdr last)) other-key)
                      (eq (plist-get plist key) value)
                      (plist-get plist other-key)) results)))
      ;; Equal strings are distinct EQ property keys too.
      (let* ((owner (make-symbol "string-key-owner"))
             (key (copy-sequence "same-key"))
             (other (copy-sequence "same-key"))
             (plist (list key 11)))
        (setplist owner plist)
        (symbol-plist-store operation owner plist other 13)
        (push (list (eq plist (symbol-plist owner)) (length plist)
                    (plist-get plist key) (plist-get plist other)) results))
      ;; A matching complete pair can precede a malformed tail. A missing
      ;; key reports plistp and the original list, without rebuilding it.
      (dolist (plist (list (list 'key) (cons 'key 37)
                           (list 'key 19 'odd) (cons 'key (cons 19 37))))
        (let ((owner (make-symbol "invalid-plist-owner")))
          (setplist owner plist)
          (push (condition-case error
                    (progn (symbol-plist-store operation owner plist 'absent 23)
                           'unexpected-success)
                  (error (list (car error) (cadr error)
                               (eq (nth 2 error) plist)
                               (eq (symbol-plist owner) plist)))) results)))
      (let* ((owner (make-symbol "partial-plist-owner"))
             (plist (cons 'key (cons 19 37))))
        (setplist owner plist)
        (symbol-plist-store operation owner plist 'key 29)
        (push (list (eq plist (symbol-plist owner)) (cadr plist) (cddr plist))
              results))
      ;; The circular-list datum is the actual tail at Brent detection.
      ;; Report its index instead of relying on printed cycle notation.
      (dolist (size '(1 3 17))
        (let ((owner (make-symbol "cyclic-plist-owner")) plist tails)
          (dotimes (i size)
            (setq plist (cons (make-symbol (format "cycle-key-%s" i))
                              (cons i plist)))
            (push plist tails))
          (setcdr (last plist) plist)
          (setplist owner plist)
          (symbol-plist-store operation owner plist (car plist) 31)
          (push (condition-case error
                    (progn (symbol-plist-store operation owner plist 'absent 41)
                           'unexpected-success)
                  (error
                   (let ((index 0) (found nil))
                     (dolist (tail tails)
                       (when (eq tail (cadr error)) (setq found index))
                       (setq index (1+ index)))
                     (list (car error) found (cadr plist)
                           (eq plist (symbol-plist owner)))))) results))))
    (nreverse results)))
