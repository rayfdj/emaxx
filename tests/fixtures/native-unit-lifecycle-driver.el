;; -*- coding: utf-8; lexical-binding: t; -*-
(defvar runtime-unit309-weak (make-hash-table :test 'eq :weakness 'key))
(defun runtime-unit309-load-check (input)
  (load (getenv "RUNTIME_UNIT309_ELN") nil t)
  (let* ((function (symbol-function 'runtime-unit309-file-worker))
         (unit (subr-native-comp-unit function)))
    (unless (native-comp-function-p function) (error "Native execution required"))
    (puthash unit input runtime-unit309-weak)
    (garbage-collect)
    (list (type-of unit) (recordp unit) (vectorp unit)
          (eq unit (subr-native-comp-unit function))
          (gethash unit runtime-unit309-weak)
          (funcall function input))))
(defvar runtime-unit309-results nil)
(dolist (input '(31 79 113))
  (push (runtime-unit309-load-check input) runtime-unit309-results)
  (fmakunbound 'runtime-unit309-file-worker)
  (dotimes (_ 6) (garbage-collect))
  (push (hash-table-count runtime-unit309-weak) runtime-unit309-results))
(prin1 (list (hash-table-weakness comp-loaded-comp-units-h)
             (nreverse runtime-unit309-results)))
