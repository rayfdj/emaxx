(let ((forms '((make-string 0 ?a)
               (make-string 0 ?a t)
               (copy-sequence "ab")
               (make-string 2 ?a t)
               (string #x3b1 ?b)
               (unibyte-string 233 98)))
      (operations '((aset value 0 ?z)
                    (aset value 9 ?z)
                    (aset value 0 'invalid-character)
                    (aset value 'invalid-index ?z)
                    (fillarray value ?z)
                    (fillarray value 'invalid-character)
                    (clear-string value)
                    (aset (copy-sequence value) 0 ?z)))
      (result nil)
      (type 0))
  (dolist (form forms)
    (dolist (pure '(nil t))
      (let ((operation-index 0))
        (dolist (operation operations)
          (let* ((original (eval form))
                 (value (if pure
                            (let ((purify-flag t)) (purecopy original))
                          original))
                 (again (let ((purify-flag t)) (purecopy value))))
            (garbage-collect)
            (push
             (list type pure operation-index
                   (eq original value) (eq value again)
                   (condition-case error
                       (let ((answer (eval operation (list (cons 'value value)))))
                         (list 'ok
                               (if (stringp answer)
                                   (list 'string-data (multibyte-string-p answer)
                                         (length answer) (string-bytes answer)
                                         (string-to-list answer))
                                 answer)))
                     (error
                      (cons 'error
                            (mapcar
                             (lambda (argument)
                               (if (stringp argument)
                                   (list 'string-data (multibyte-string-p argument)
                                         (length argument) (string-bytes argument)
                                         (string-to-list argument))
                                 argument))
                             error))))
                   (length value) (string-bytes value)
                   (multibyte-string-p value)
                   (string-to-list value))
             result))
          (setq operation-index (1+ operation-index)))))
    (setq type (1+ type)))
  (nreverse result))
