(progn
  (require 'comp)
  (let ((lexical-binding t) rows)
    (dolist (parts '(("native-name-prefix-" "suffix")
                     ("native-name-λ-" "tail")
                     ("" "native-empty-prefix")))
      (let* ((name (intern (concat (car parts) (string 0) (cadr parts))))
             (prefix (car parts)))
        (fset name (lambda (argument) (+ argument 3)))
        (native-compile name)
        (let ((function (symbol-function name)))
          (unless (native-comp-function-p function)
            (error "Name fixture must execute native code"))
          (garbage-collect)
          (push (list (equal (symbol-name name)
                             (concat prefix (string 0) (cadr parts)))
                      (subr-name function)
                      (equal (prin1-to-string function)
                             (concat "#<subr " prefix ">"))
                      (let ((printed (prin1-to-string function)))
                        (list (string-to-list printed) (multibyte-string-p printed)))
                      (let (characters)
                        (prin1 function (lambda (character) (push character characters)))
                        (nreverse characters))
                      (let ((print-unreadable-function
                             (lambda (object _escape)
                               (and (eq object function) "native-name-custom"))))
                        (prin1-to-string function))
                      (funcall name 7) (funcall function 29)) rows))))
    (nreverse rows)))
