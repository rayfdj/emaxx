(progn
  (require 'comp)
  (let* ((lexical-binding t)
         (plus (native-compile '(lambda (left right) (+ left right))))
         (minus (native-compile '(lambda (left right) (- left right))))
         (lo most-negative-fixnum)
         (hi most-positive-fixnum)
         (values (list lo (1+ lo) -47 -1 0 1 83 (1- hi) hi
                       (1- lo) (1+ hi) (- (ash 1 63)) (1- (ash 1 63))
                       1.5 'native-arithmetic-error nil))
         (pairs (append (mapcar (lambda (x) (list x 1)) values)
                        (mapcar (lambda (x) (list -1 x)) values)
                        (mapcar (lambda (x) (list x 0)) values)
                        (list (list hi hi) (list lo lo) (list lo hi)
                              (list hi lo) (list hi -1) (list lo 1))))
         rows)
    (unless (and (native-comp-function-p plus) (native-comp-function-p minus))
      (error "Arithmetic workers must execute native code"))
    (dolist (operator '(+ -))
      (dolist (pair pairs)
        (let ((answer (condition-case error
                          (apply (if (eq operator '+) plus minus) pair)
                        (error error))))
          (garbage-collect)
          (push (list operator pair answer (integerp answer) (fixnump answer)) rows))))
    (list (native-comp-function-p plus) (native-comp-function-p minus)
          (nreverse rows)
          (with-temp-buffer
            (insert "abcdefgh")
            (let ((marker (copy-marker 3)))
              (list (funcall plus marker 5)
                    (funcall minus marker 2)
                    (funcall plus 11 marker)
                    (funcall minus 11 marker)))))))
