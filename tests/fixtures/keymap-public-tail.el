(list
 (let* ((map (make-keymap)) (tail (cdr map)) (seen nil))
   (setcdr tail (cons (cons 65 'sparse) (cdr tail)))
   (define-key map [65] 'table)
   (define-key map [f10] 'symbol-command)
   (map-keymap #'(lambda (key value) (setq seen (cons (list key value) seen))) map)
   (list (lookup-key map [65]) (assq 65 (cdr map)) (nreverse seen)))
 (let* ((map (make-keymap)) (tail (cdr map)))
   (setcdr tail (cons (cons 65 'sparse) (cdr tail)))
   (define-key map [65] 'table)
   (define-key map [65] nil t)
   (list (lookup-key map [65]) (assq 65 (cdr map))))
 (let* ((map (make-sparse-keymap)) (seen nil))
   (define-key map [66] 'before)
   (define-key map [65] 'first)
   (let ((slot (assq 66 (cdr map))))
     (map-keymap #'(lambda (key value)
                    (setq seen (cons (list key value) seen))
                    (if (equal key 65)
                        (progn (setcdr slot 'after)
                               (garbage-collect)))) map))
   (nreverse seen))
 (let ((map (make-keymap)) (branch (make-sparse-keymap)))
   (define-key branch [120] 'cycle-command)
   (define-key map [65] branch)
   (define-key branch [66] map)
   (where-is-internal 'cycle-command (list map))))
