(progn
  (defun symbol-redirect-fill (tables)
    (let ((current-load-list nil)
          (warning-minimum-level :error)
          (live (make-vector 6 nil))
          (index 0))
      (dolist (size '(1 17 129))
        (let ((alias (make-symbol (format "redirect-%d" size)))
              (first (make-symbol (format "first-%d" size)))
              (next (make-symbol (format "next-%d" size)))
              (previous (make-symbol (format "previous-%d" size)))
              (transfer (make-symbol (format "transfer-%d" size)))
              (target (make-symbol (format "target-%d" size)))
              (handed (make-symbol (format "handed-%d" size))))
          (puthash previous size (aref tables 0))
          (puthash first size (aref tables 1))
          (puthash next size (aref tables 2))
          (puthash handed size (aref tables 3))
          (set alias previous)
          (set first (vector size))
          (set next (vector (+ size 7)))
          (fset alias (list 'lambda nil size))
          (setplist alias (list 'payload (make-string size ?r)))
          (defvaralias alias first)
          (defvaralias alias next)
          (set transfer handed)
          ;; An unbound target inherits the old value before the redirect
          ;; overwrites the alias's value slot (eval.c:Fdefvaralias).
          (defvaralias transfer target)
          (aset live index alias)
          (aset live (1+ index) transfer)
          (setq index (+ index 2))))
      live))
  (defun symbol-redirect-read (live)
    (let (result)
      (dotimes (index 3)
        (let ((alias (aref live (* index 2)))
              (transfer (aref live (1+ (* index 2)))))
          (push (list (aref (symbol-value alias) 0)
                      (funcall alias)
                      (length (get alias 'payload))
                      (eq (symbol-value transfer)
                          (symbol-value (indirect-variable transfer))))
                result)))
      (nreverse result)))
  (defun symbol-redirect-observe (tables)
    (let ((live (symbol-redirect-fill tables)) counts values)
      (garbage-collect)
      (garbage-collect)
      (setq counts (mapcar #'hash-table-count (append tables nil)))
      (setq values (symbol-redirect-read live))
      (setq live nil)
      (list counts values)))
  (let* ((tables (vector (make-hash-table :test 'eq :weakness 'key)
                         (make-hash-table :test 'eq :weakness 'key)
                         (make-hash-table :test 'eq :weakness 'key)
                         (make-hash-table :test 'eq :weakness 'key)))
         (observed (symbol-redirect-observe tables)))
    ;; Return from the frame that held LIVE before checking reclamation.
    ;; A conservative C stack can still retain its old argument slots after
    ;; setq; neither editor must imitate the other's incidental stack words.
    (garbage-collect)
    (garbage-collect)
    (append observed (list (mapcar #'hash-table-count (append tables nil))))))
