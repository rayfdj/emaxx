(let ((codes '(0 65 127 128 255 2047 2048 55296 57343 57472
                 63743 65535 65536 1114111 1114112 2097151 2097152
                 4194175 4194176 4194303))
      (rows nil))
  (dolist (code codes)
    (let* ((value (string code))
           (source (concat "\"" value "\" tail"))
           (plain (read source))
           (bounded (read-from-string (concat "ignored " source) 8))
           (character (read (concat "?" value " ")))
           (escaped-character (and (>= code 128)
                                   (read (concat "?\\" value " ")))))
      (push (list code (string-to-list plain) (multibyte-string-p plain)
                  (string-to-list (car bounded)) (cdr bounded)
                  character escaped-character)
            rows)))
  (dolist (raw '(128 255))
    (let* ((source (concat (unibyte-string 34 raw 34) " end"))
           (answer (read-from-string source)))
      (push (list 'unibyte raw (string-to-list (car answer))
                  (multibyte-string-p (car answer)) (cdr answer)) rows)))
  (let* ((name (concat "reader-code-" (string 955) "-83941"))
         (source (concat "[" name " " name "]"))
         (answer (read source)))
    (push (list (eq (aref answer 0) (aref answer 1))
                (string-to-list (symbol-name (aref answer 0)))) rows))
  (let* ((source (concat "#1=[\"" (string 2097152) "\" #1#]"))
         (answer (read source)))
    (garbage-collect)
    (push (list (string-to-list (aref answer 0))
                (eq answer (aref answer 1))) rows))
  (nreverse rows))
