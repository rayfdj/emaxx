(let ((executing-kbd-macro (vector 'reader-macro-a 'reader-macro-b))
      (executing-kbd-macro-index 0)
      (unread-command-events (list 'reader-unread))
      (trace nil))
  (dotimes (_ 2)
    (push (list (read-event nil nil 0) executing-kbd-macro-index) trace))
  (setq executing-kbd-macro-index 0)
  (push (list (read-event nil nil 0) executing-kbd-macro-index) trace)
  (let ((inhibit-interaction t))
    (push (condition-case failure
              (read-event nil nil 0)
            (error (list (car failure) executing-kbd-macro-index))) trace))
  (let ((executing-kbd-macro-index -1))
    (push (condition-case failure
              (read-event nil nil 0)
            (error (list (car failure) executing-kbd-macro-index))) trace))
  (setq executing-kbd-macro t)
  (push (list (read-event nil nil 0) executing-kbd-macro-index) trace)
  (nreverse trace))
