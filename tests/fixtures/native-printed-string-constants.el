(progn
  (require 'comp)
  (let* ((codes '(128 255 55296 57343 63743 65535 65536 1114111
                     1114112 2097151 2097152 4194175 4194176 4194303))
         (literal (apply #'string codes))
         (decorated (propertize (copy-sequence literal) 'probe-native 83729))
         (payload (vector literal decorated literal))
         (worker (native-compile (list 'lambda nil (list 'quote payload)))))
    (unless (native-comp-function-p worker)
      (error "Native literal probe did not compile"))
    (garbage-collect)
    (let ((answer (funcall worker)))
      (list (native-comp-function-p worker)
            (eq (aref answer 0) (aref answer 2))
            (equal (string-to-list (aref answer 0)) codes)
            (string-to-list (aref answer 0))
            (string-to-list (aref answer 1))
            (get-text-property 3 'probe-native (aref answer 1))
            (string-bytes (aref answer 0))
            (multibyte-string-p (aref answer 0))))))
