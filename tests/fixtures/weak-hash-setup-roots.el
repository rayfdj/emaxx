(let (table keys roots counts)
  (funcall (lambda ()
             (setq table (make-hash-table :test 'eq :weakness 'key)
                   keys (mapcar #'list '(0 1 2 3 4 5 6 7 8)))
             (dolist (key keys) (puthash key (car key) table))
             (setq roots (butlast keys))
             nil))
  (garbage-collect)
  (setq counts (list (hash-table-count table)))
  (funcall (lambda () (setq keys nil) nil))
  (garbage-collect)
  (setq counts (append counts (list (hash-table-count table))))
  (funcall (lambda () (setq roots (cdr roots)) nil))
  (garbage-collect)
  (append counts (list (hash-table-count table))))
