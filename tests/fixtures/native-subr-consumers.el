(progn
  (require 'comp)
  (require 'bytecomp)
  (let* ((lexical-binding t)
         (command (native-compile '(lambda (&optional argument)
                                     (interactive "p") argument)))
         (plain (native-compile '(lambda (argument) argument)))
         (table (native-compile
                 '(lambda (text predicate action)
                    (complete-with-action action '("candle" "candy" "canvas")
                                          text predicate))))
         (native-check (native-compile '(lambda (function) (commandp function))))
         (byte-check (byte-compile '(lambda (function) (commandp function))))
         (target (make-symbol "native-command-owner"))
         (alias (make-symbol "native-command-alias"))
         rows)
    (unless (and (native-comp-function-p command) (native-comp-function-p plain)
                 (native-comp-function-p table) (native-comp-function-p native-check)
                 (byte-code-function-p byte-check))
      (error "Required execution modes are absent"))
    (fset target command)
    (fset alias target)
    (push (list (commandp command) (commandp command t) (commandp plain)
                (commandp target) (commandp alias)
                (funcall byte-check command) (funcall native-check command)
                (let ((current-prefix-arg 7)) (call-interactively command))) rows)
    (put alias 'interactive-form '(interactive "ignored"))
    (push (commandp alias) rows)
    (fset target plain)
    (push (condition-case data (commandp alias) (error (car data))) rows)
    (put alias 'interactive-form nil)
    (push (commandp alias) rows)
    (dolist (prefix '("can" "cand" "canvas" "zzz"))
      (push (condition-case data
                (list prefix (try-completion prefix table)
                      (all-completions prefix table) (test-completion prefix table))
              (error (list prefix (car data)))) rows))
    (let ((tree (list command (vector command))))
      (lread--substitute-object-in-subtree tree command t)
      (push (list (eq (car tree) tree) (eq (aref (cadr tree) 0) tree)) rows))
    (dolist (other (list plain (symbol-function 'cons)))
      (let* ((tree (list command (vector command other)))
             (condition (condition-case data
                            (lread--substitute-object-in-subtree tree command t)
                          (error (list (car data) (cadr data) (eq (caddr data) other))))))
        (push (list condition (eq (car tree) tree) (eq (aref (cadr tree) 0) tree)
                    (eq (aref (cadr tree) 1) other)) rows)))
    (with-temp-buffer
      (insert "abcdef")
      (put-text-property 1 4 'native-callback command)
      (put-text-property 4 7 'native-callback command)
      (let ((same (next-single-property-change 1 'native-callback nil 7)))
        (put-text-property 5 7 'native-callback plain)
        (push (list same (next-single-property-change 1 'native-callback nil 7)
                    (eq (get-text-property 2 'native-callback) command)
                    (eq (get-text-property 6 'native-callback) plain)) rows)))
    (nreverse rows)))
