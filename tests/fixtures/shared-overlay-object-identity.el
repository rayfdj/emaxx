;;; -*- lexical-binding: t; -*-
(progn
  (require 'bytecomp)
  (let ((a (generate-new-buffer " overlay-geometry-alpha"))
        (b (generate-new-buffer " overlay-geometry-beta"))
        (dead (generate-new-buffer " overlay-geometry-dead"))
        results)
    (unwind-protect
        (progn
          (kill-buffer dead)
          (with-current-buffer a
            (insert "abcdefghijklmnopqrst")
            (narrow-to-region 4 10)
            (let ((object (make-overlay -5 90)))
              (push (list (overlay-start object) (overlay-end object)) results)
              (with-current-buffer b
                (insert "123456789")
                (move-overlay object 2 9)
                (push (list (eq (overlay-buffer object) a)
                            (overlay-start object) (overlay-end object)) results)))
            (widen)
            (delete-all-overlays a)
            (let ((foreign (with-current-buffer b (copy-marker 3))))
              (push (condition-case err
                        (make-overlay 'invalid foreign a)
                      (error (list (car err) (cadr err) (eq (caddr err) foreign))))
                    results)
              (set-marker foreign nil))
            (push (condition-case err (make-overlay 'invalid 2 'invalid)
                    (error (list (car err) (cadr err)))) results)
            (push (condition-case err (make-overlay 'invalid 2 dead)
                    (error (list (car err) (cadr err)))) results)
            (push (condition-case err (overlay-recenter '(invalid))
                    (error (list (car err) (cadr err)))) results)
            (let ((outer (make-overlay 1 15))
                  (inner (make-overlay 3 8))
                  (high (make-overlay 2 12)))
              (overlay-put outer 'label 'outer)
              (overlay-put inner 'label 'inner)
              (overlay-put high 'label 'high)
              (overlay-put high 'priority '(1 . -9))
              (push (mapcar (lambda (o) (overlay-get o 'label)) (overlays-at 4 t)) results)
              (goto-char 20)
              (push (list (length (car (overlay-lists))) (cdr (overlay-lists))) results)
              (delete-overlay outer)
              (delete-overlay inner)
              (overlay-put outer 'label 'same)
              (overlay-put inner 'label 'same)
              (overlay-put outer 'cycle outer)
              (overlay-put inner 'cycle inner)
              (let ((table (make-hash-table :test 'equal)))
                (puthash outer 'matched table)
                (garbage-collect)
                (push (list (equal outer inner) (gethash inner table)
                            (eq outer inner)) results)))
            (delete-all-overlays a)
            ;; Hook functions and overlay objects must survive removal from
            ;; the buffer and collections between the before/after callbacks.
            (let (events)
              (dotimes (index 3)
                (let ((o (make-overlay 2 9)))
                  (overlay-put o 'label index)
                  (overlay-put o 'modification-hooks
                               (list (lambda (object after &rest ignored)
                                       (push (list (overlay-get object 'label) (not (null after))) events)
                                       (delete-all-overlays (current-buffer))
                                       (garbage-collect))))))
              (goto-char 5)
              (insert "X")
              (push (nreverse events) results))
            (delete-all-overlays a)
            ;; Mixed endpoint flags, moves, deletions, and forced collection.
            (let ((read-bounds (byte-compile '(lambda (o) (list (overlay-start o) (overlay-end o)))))
                  (objects nil))
              (dotimes (flags 4)
                (let ((o (make-overlay 4 4 nil (/= 0 (logand flags 1)) (/= 0 (logand flags 2)))))
                  (overlay-put o 'label flags)
                  (push o objects)))
              (setq objects (nreverse objects))
              (goto-char 4) (insert "yz")
              (push (mapcar read-bounds objects) results)
              (goto-char 4) (insert-before-markers "K")
              (push (mapcar read-bounds objects) results)
              (delete-region 3 8)
              (garbage-collect)
              (push (mapcar read-bounds objects) results)
              (mapc (lambda (o) (overlay-put o 'evaporate t)) objects)
              (push (mapcar #'overlay-buffer objects) results))
            (delete-all-overlays a))
          (nreverse results))
      (when (buffer-live-p a) (kill-buffer a))
      (when (buffer-live-p b) (kill-buffer b))
      (when (buffer-live-p dead) (kill-buffer dead)))))
