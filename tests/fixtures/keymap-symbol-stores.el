(let ((first (make-sparse-keymap))
      (second (make-sparse-keymap))
      (file (make-temp-file "keymap-symbol-stores-" nil ".el"))
      (inhibit-message t)
      answers)
  (unwind-protect
      (progn
        (fset 'keymap-store-target first)
        (fset 'keymap-store-alias 'keymap-store-target)
        (push (define-key 'keymap-store-alias [leaf] 'first-command) answers)
        (push (lookup-key first [leaf]) answers)
        (define-key 'keymap-store-target [(97 . 99)] 'range-command)
        (push (mapcar (lambda (key) (lookup-key first (vector key))) '(97 98 99)) answers)
        (define-key 'keymap-store-alias [(97 . 98)] nil t)
        (push (mapcar (lambda (key) (lookup-key first (vector key))) '(97 98 99)) answers)
        (fset 'keymap-store-target second)
        (define-key 'keymap-store-alias [leaf] 'second-command)
        (push (list (lookup-key first [leaf]) (lookup-key second [leaf])) answers)
        (push (list (define-key 'keymap-store-alias [] 'unused)
                    (define-key 'keymap-store-alias "" 'unused)) answers)
        (dolist (key '(nil 17 unexpected (97)))
          (push (condition-case data (define-key 'keymap-store-alias key 'bad)
                  (error data)) answers))
        (push (condition-case data (define-key 'missing-keymap-store nil 'bad)
                (error data)) answers)
        (write-region "(garbage-collect)\n(fset 'keymap-store-lazy (make-sparse-keymap))\n"
                      nil file nil 'silent)
        (autoload 'keymap-store-lazy file nil nil 'keymap)
        (define-key 'keymap-store-lazy [loaded] 'loaded-command)
        (push (lookup-key (symbol-function 'keymap-store-lazy) [loaded]) answers)
        (nreverse answers))
    (delete-file file)
    (mapc #'fmakunbound '(keymap-store-alias keymap-store-target keymap-store-lazy))))
