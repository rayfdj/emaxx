(let* ((left (intern "allocated-owner" (obarray-make)))
       (right (intern "allocated-owner" (obarray-make)))
       (shared left)
       (first (list 'field (vector 41)))
       (second (list 'field (vector 53))))
  (fset left '(lambda () 37))
  (setplist left first)
  (fset right '(lambda () 47))
  (setplist right second)
  (garbage-collect)
  (let ((independent (list (not (eq left right))
                           (= (funcall left) 37)
                           (= (funcall right) 47)
                           (eq (symbol-plist left) first)
                           (eq (symbol-plist right) second))))
    (fset shared '(lambda () 59))
    (setplist shared second)
    (garbage-collect)
    (append independent
            (list (eq shared left)
                  (= (funcall left) 59)
                  (eq (symbol-plist left) second)
                  (= (aref (get left 'field) 0) 53)))))
