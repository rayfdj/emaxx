(let (states events watcher sample)
  (setq watcher (lambda (_symbol _value operation where)
                  (push (list operation (if (bufferp where) 'buffer where)) events))
        sample (lambda (label)
                 (push (list label text-conversion-style
                             (default-value 'text-conversion-style)
                             (local-variable-p 'text-conversion-style)
                             (cdr (assq 'text-conversion-style (buffer-local-variables))))
                       states)))
  (set-default 'text-conversion-style '(default-193))
  (add-variable-watcher 'text-conversion-style watcher)
  (unwind-protect
      (with-temp-buffer
        (funcall sample 'initial)
        (setq text-conversion-style [local-197 7])
        (funcall sample 'assigned)
        (let ((text-conversion-style '(temporary-199)))
          (funcall sample 'local-let))
        (funcall sample 'local-restored)
        (kill-local-variable 'text-conversion-style)
        (funcall sample 'killed)
        (let ((text-conversion-style '(default-let-211)))
          (funcall sample 'default-let)
          (setq text-conversion-style '(default-set-223))
          (funcall sample 'default-set)
          (make-local-variable 'text-conversion-style)
          (setq text-conversion-style '(explicit-local-227))
          (funcall sample 'made-local))
        (funcall sample 'default-restored)
        (let ((text-conversion-style '(local-let-229)))
          (kill-local-variable 'text-conversion-style)
          (funcall sample 'killed-during-let))
        (funcall sample 'after-killed-let)
        (setq text-conversion-style '(mode-local-233))
        (put 'text-conversion-style 'permanent-local t)
        (kill-all-local-variables)
        (funcall sample 'after-mode-change))
    (remove-variable-watcher 'text-conversion-style watcher)
    (put 'text-conversion-style 'permanent-local nil))
  (list (nreverse states) (nreverse events)))
