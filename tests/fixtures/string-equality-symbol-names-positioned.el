(let* ((byte-name (unibyte-string #x80))
       (byte8-name (string #x3fff80))
       (private-name (string #xe080))
       (plain (make-symbol "renamed-comparison"))
       (byte-symbol (make-symbol byte-name))
       (byte8-symbol (make-symbol byte8-name))
       (private-symbol (make-symbol private-name))
       (cases (list (cons 'nil-symbol nil) (cons 'nil-text "nil")
                    (cons 'true-symbol t) (cons 'true-text "t")
                    (cons 'plain-symbol plain)
                    (cons 'plain-text "renamed-comparison")
                    (cons 'byte-symbol byte-symbol) (cons 'byte-text byte-name)
                    (cons 'byte8-symbol byte8-symbol) (cons 'byte8-text byte8-name)
                    (cons 'private-symbol private-symbol) (cons 'private-text private-name)
                    (cons 'positioned-plain (position-symbol plain 17))
                    (cons 'positioned-byte8 (position-symbol byte8-symbol 257))
                    (cons 'invalid-number 12345) (cons 'invalid-vector [1 2 3])))
       (result nil))
  (dolist (enabled '(nil t))
    (let ((symbols-with-pos-enabled enabled))
      (dolist (left cases)
        (dolist (right cases)
          (push (list enabled (car left) (car right)
                      (condition-case err
                          (string-equal (cdr left) (cdr right))
                        (error (list (car err) (cadr err)
                                     (eq (caddr err) (cdr left))
                                     (eq (caddr err) (cdr right))))))
                result)))))
  (nreverse result))
