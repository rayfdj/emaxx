(list
 (let* ((map (make-keymap)) (table (car (cdr map))) (seen nil))
   (aset table 65 'first)
   (aset table 90 'before)
   (map-keymap #'(lambda (key value)
                  (setq seen (cons (list key value) seen))
                  (if (equal key 65)
                      (progn (aset table 90 (list 'after))
                             (garbage-collect)))) map)
   (nreverse seen))
 (let ((map (make-keymap)) (seen nil))
   (define-key map [(65 . 66)] 'first)
   (define-key map [(90 . 91)] 'second)
   (map-keymap #'(lambda (key value) (setq seen (cons (list key value) seen))) map)
   (nreverse seen))
 (let* ((map (make-keymap)) (tail (cdr map)) (seen nil))
   (setcdr tail (cons (cons 65 'sparse) (cdr tail)))
   (define-key map [65] 'table)
   (define-key map [(65 . 66)] 'range)
   (map-keymap #'(lambda (key value) (setq seen (cons (list key value) seen))) map)
   (list (lookup-key map [65]) (nreverse seen)))
 (let ((map (make-keymap)) (seen nil))
   (define-key map [65] nil)
   (map-keymap #'(lambda (key value) (setq seen (cons (list key value) seen))) map)
   (nreverse seen)))
