(progn
  (require 'comp)
  (require 'bytecomp)
  (let (results)
    (dolist (name '(shared-string-native-hop renamed-string-native-hop))
      (let* ((source (make-temp-file (symbol-name name) nil ".el"))
             (output (make-temp-file "shared-string-native-output-" t))
             (comp-no-spawn nil)
             (comp-running-batch-compilation t)
             (native-comp-jit-compilation nil)
             (interpreted
              (make-interpreted-closure
               '(object expected)
               '((garbage-collect)
                 (and (= (aref object 0) expected) object))
               '(t) nil))
             (byte
              (byte-compile
               '(lambda (object expected)
                  (garbage-collect)
                  (and (= (aref object 0) expected) object))))
             (valid t)
             (count 0))
        (unwind-protect
            (progn
              (with-temp-file source
                (insert ";;; -*- lexical-binding: t -*-\n")
                (prin1
                 `(defun ,name (object callback character leaf)
                    (aset object 0 character)
                    (put-text-property 0 (length object) 'audit-cycle object object)
                    (put-text-property 0 (length object) 'audit-leaf leaf object)
                    (garbage-collect)
                    (and (stringp object)
                         (eq (funcall callback object character) object)
                         (eq (get-text-property 0 'audit-cycle object) object)
                         (eq (get-text-property 0 'audit-leaf object) leaf)
                         (= (aref object 0) character)))
                 (current-buffer)))
              (native-elisp-load
               (native-compile source (expand-file-name "shared.eln" output)))
              (dolist (length '(1 17 257))
                (dolist (multibyte '(nil t))
                  (let ((object (if multibyte
                                    (make-string length 955)
                                  (string-make-unibyte (make-string length 65))))
                        (leaf (concat (symbol-name name) "-leaf")))
                    (dolist (callback (list interpreted byte))
                      (dolist (character (if multibyte '(0 955 128578) '(0 65 255)))
                        (setq count (1+ count))
                        (unless (and (funcall name object callback character leaf)
                                     (= (length object) length)
                                     (= (aref object 0) character)
                                     (eq (get-text-property 0 'audit-cycle object) object)
                                     (eq (get-text-property 0 'audit-leaf object) leaf))
                          (setq valid nil)))))))
              (push (list (native-comp-function-p (symbol-function name))
                          (byte-code-function-p byte)
                          (eq (type-of interpreted) 'interpreted-function)
                          valid count)
                    results))
          (fmakunbound name)
          (delete-file source)
          (delete-directory output t))))
    (nreverse results)))
