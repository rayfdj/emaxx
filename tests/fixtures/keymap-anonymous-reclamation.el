(let ((weak (make-hash-table :test 'eq :weakness 'value)))
  (funcall (lambda (table)
             (let ((sparse (make-sparse-keymap))
                   (full (make-keymap)))
               (define-key sparse [leaf] 'anonymous-command)
               (set-keymap-parent full sparse)
               (puthash 'sparse sparse table)
               (puthash 'full full table)
               (garbage-collect)
               (unless (and (= (hash-table-count table) 2)
                            (eq (lookup-key full [leaf]) 'anonymous-command))
                 (error "Live anonymous maps were not retained")))
             nil)
           weak)
  (garbage-collect)
  (hash-table-count weak))
