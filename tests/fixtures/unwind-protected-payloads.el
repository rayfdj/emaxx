(progn
  (require 'bytecomp)
  (put 'unwind-payload-condition 'error-conditions '(unwind-payload-condition error))
  (put 'unwind-payload-condition 'error-message "Protected payload")
  (let* ((body '(lambda (exit-kind replace)
                 (unwind-protect
                     (let ((payload (list (make-string 513 120)
                                          (vector (make-symbol "payload-symbol")
                                                  (cons 37 (list 91))))))
                       (cond ((eq exit-kind 'signal)
                              (signal 'unwind-payload-condition payload))
                             ((eq exit-kind 'throw)
                              (throw 'payload-exit payload))
                             (t payload)))
                   (garbage-collect)
                   (when replace
                     (signal 'unwind-payload-condition (list "replacement"))))))
         (compiled (byte-compile body))
         answers)
    (unless (byte-code-function-p compiled)
      (error "Payload control did not compile to bytecode"))
    (dolist (function (list body compiled))
      (let (outcomes)
        (dolist (exit-kind '(return signal throw))
          (let* ((result
                  (condition-case data
                      (catch 'payload-exit (funcall function exit-kind nil))
                    (unwind-payload-condition (cdr data))))
                 (item (list (length (car result))
                             (symbol-name (aref (cadr result) 0))
                             (aref (cadr result) 1))))
            (push item outcomes)))
        (push (list (byte-code-function-p function)
                    (nreverse outcomes)
                    (condition-case data (funcall function 'signal t)
                      (unwind-payload-condition data)))
              answers)))
    (nreverse answers)))
