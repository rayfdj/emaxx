(let ((names (list (concat "lookup-miss-" "first")
                         (concat ":lookup-miss-" "second")
                         (concat "lookup-miss-" "λ-third"))))
  (mapcar
   (lambda (name)
     (unintern name)
     (let* ((first (intern-soft name))
            (second (intern-soft name))
            (private (make-symbol name)))
       (fboundp private)
       (let ((third (intern-soft name))
             (symbol (intern name)))
         (list (null first) (null second) (null third)
               (eq (intern-soft name) symbol)
               (eq (intern-soft name) symbol)
               (not (eq private symbol))))))
   names))
