(let ((saved-global-map (current-global-map))
      (inhibit-message t))
  (unwind-protect
      (progn
        (use-global-map (make-sparse-keymap))
        (list
         (let ((input-decode-map (make-sparse-keymap))
               (local-function-key-map (make-sparse-keymap))
               (key-translation-map (make-sparse-keymap))
               (overriding-local-map (make-sparse-keymap))
               (unread-command-events '(alpha 122))
               (filters 0))
           (define-key input-decode-map [alpha] [first second third])
           (define-key overriding-local-map [first]
             (list 'menu-item "First" 'ignore
                   :filter (lambda (command)
                             (setq filters (1+ filters))
                             (garbage-collect)
                             command)))
           (list (read-key-sequence-vector nil) unread-command-events
                 (this-command-keys-vector) filters))
         (let ((input-decode-map (make-sparse-keymap))
               (local-function-key-map (make-sparse-keymap))
               (key-translation-map (make-sparse-keymap))
               (overriding-local-map (make-sparse-keymap)))
           (define-key overriding-local-map "a" 'ignore)
           (mapcar (lambda (dont-downcase)
                     (let ((unread-command-events '(65 122)))
                       (list (read-key-sequence-vector nil nil dont-downcase)
                             unread-command-events)))
                   '(nil t)))
         (let ((input-decode-map (make-sparse-keymap))
               (local-function-key-map (make-sparse-keymap))
               (key-translation-map (make-sparse-keymap))
               (overriding-local-map (make-sparse-keymap)))
           (define-key overriding-local-map "ab" 'ignore)
           (mapcar (lambda (dont-downcase)
                     (let ((unread-command-events '(65 66 122)))
                       (list (read-key-sequence-vector nil nil dont-downcase)
                             unread-command-events)))
                   '(nil t)))
         (let ((unread-command-events '(97 122)))
           (condition-case err (read-key-sequence-vector 42)
             (error (list err unread-command-events))))
         (let ((input-decode-map (make-sparse-keymap))
               (current-key-remap-sequence 'outer)
               (unread-command-events '(97 122))
               (seen nil))
           (define-key input-decode-map [97]
             (lambda (prompt)
               (setq seen (list prompt current-key-remap-sequence))
               (garbage-collect)
               (throw 'decoder-exit 'finished)))
           (list (catch 'decoder-exit (read-key "Prompt: "))
                 current-key-remap-sequence seen unread-command-events))
         (let ((input-decode-map (make-sparse-keymap))
               (local-function-key-map (make-sparse-keymap))
               (key-translation-map (make-sparse-keymap))
               (overriding-local-map (make-sparse-keymap))
               (unread-command-events '(alpha beta 122)))
           (define-key input-decode-map [alpha] [])
           (define-key overriding-local-map [beta] 'ignore)
           (list (read-key-sequence-vector nil) unread-command-events))))
    (use-global-map saved-global-map)))
