(let ((input-decode-map (make-sparse-keymap))
      (local-function-key-map (make-sparse-keymap))
      (key-translation-map (make-sparse-keymap))
      (trace nil)
      (history-add-new-input nil))
  (define-key input-decode-map [f32 f33] [f34])
  (define-key local-function-key-map [f34] [f35])
  (define-key key-translation-map [f35]
    (lambda (_prompt)
      (push (list (copy-sequence current-key-remap-sequence)
                  executing-kbd-macro-index)
            trace)
      (garbage-collect)
      [113]))
  (list
   (let ((executing-kbd-macro [f32 f33 13])
         (executing-kbd-macro-index 0))
     (list (read-from-minibuffer "reader: ") executing-kbd-macro-index))
   (let ((executing-kbd-macro t)
         (executing-kbd-macro-index 0)
         (unread-command-events (list 'f32 'f33 13)))
     (read-from-minibuffer "reader: "))
   (let ((executing-kbd-macro [f33 13])
         (executing-kbd-macro-index 0)
         (unread-command-events (list 'f32)))
     (list (read-from-minibuffer "reader: ") executing-kbd-macro-index))
   (nreverse trace)))
