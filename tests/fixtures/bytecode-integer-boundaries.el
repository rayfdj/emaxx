(let* ((lo most-negative-fixnum)
       (hi most-positive-fixnum)
       (values (list lo (1+ lo) -17 -1 0 1 19 (1- hi) hi
                     (1- lo) (1+ hi) (- (ash 1 63)) (1- (ash 1 63))
                     1.5 'numeric-boundary-error nil))
       (pairs (append (mapcar (lambda (x) (list x 1)) values)
                      (mapcar (lambda (x) (list x -1)) values)
                      (mapcar (lambda (x) (list x 0)) values)
                      (list (list hi hi) (list lo lo) (list lo hi)
                            (list hi 2) (list lo 2) (list 17 3))))
       rows)
  (dolist (opcode '(92 90 95 165 166 85 86 87 88 89))
    (dolist (pair pairs)
      (let* ((constants (vconcat pair))
             (answer (condition-case error
                         (byte-code (unibyte-string 192 193 opcode 135)
                                    constants 2)
                       (error error))))
        (garbage-collect)
        (push (list opcode pair answer (integerp answer) (fixnump answer)) rows))))
  (dolist (opcode '(84 83 91))
    (dolist (value values)
      (let ((answer (condition-case error
                        (byte-code (unibyte-string 192 opcode 135)
                                   (vector value) 1)
                      (error error))))
        (garbage-collect)
        (push (list opcode value answer (integerp answer) (fixnump answer)) rows))))
  (nreverse rows))
