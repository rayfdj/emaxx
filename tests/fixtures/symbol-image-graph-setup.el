(setq image-graph-canonical 'image-graph-canonical
      image-graph-private (make-symbol "private-node")
      image-graph-property (make-symbol "private-property")
      image-graph-obarray (make-vector 7 0)
      image-graph-obarray-symbol (intern "private-node" image-graph-obarray)
      image-graph-argument (make-symbol "private-argument")
      image-graph-lambda (list 'lambda (list image-graph-argument)
                             image-graph-argument)
      image-graph-string (copy-sequence "graph")
      image-graph-eq-table (make-hash-table :test 'eq)
      image-graph-watcher-result nil)
(define-hash-table-test 'image-graph-eq #'eq #'sxhash-eq)
(setq image-graph-user-table (make-hash-table :test 'image-graph-eq))
(set image-graph-private image-graph-private)
(fset image-graph-private (list 'lambda nil (list 'quote image-graph-private)))
(setplist image-graph-private (list image-graph-property image-graph-private))
(put-text-property 0 1 image-graph-property image-graph-private
                   (symbol-name image-graph-private))
(put-text-property 0 1 image-graph-property image-graph-private
                   image-graph-string)
(puthash image-graph-private image-graph-obarray-symbol image-graph-eq-table)
(puthash image-graph-private image-graph-obarray-symbol image-graph-user-table)
(defvaralias 'image-graph-alias 'image-graph-canonical)
(defun image-graph-watcher (symbol value operation where)
  (setq image-graph-watcher-result (list symbol value operation where)))
(add-variable-watcher image-graph-private #'image-graph-watcher)
(with-current-buffer (get-buffer-create " *image-symbol-graph*")
  (erase-buffer)
  (insert "graph")
  (put-text-property 1 2 image-graph-property image-graph-private)
  (make-local-variable image-graph-private)
  (set image-graph-private image-graph-obarray-symbol))
