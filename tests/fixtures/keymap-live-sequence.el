(progn
  (require 'cl-lib)
  (let (answers)
    (dolist (case (list (list (vector 'prefix 'first) 'first 'second 'second)
                       (list (string ?p ?α) ?α ?β ?β)
                       (list (unibyte-string ?p 129) #x8000001 #x8000002 130)
                       (list (vector 'prefix '(control alpha))
                             'C-alpha 'M-beta '(meta beta))))
      (let ((keys (nth 0 case))
            (map (make-sparse-keymap))
            (prefix (make-sparse-keymap))
            (calls 0))
        (define-key prefix (vector (nth 1 case)) 'first-command)
        (define-key prefix (vector (nth 2 case)) 'second-command)
        (define-key map (vector (aref keys 0))
          (list 'menu-item "Prefix" prefix
                :filter (lambda (definition)
                          (setq calls (1+ calls))
                          (aset keys 1 (nth 3 case))
                          (garbage-collect)
                          definition)))
        (push (list (lookup-key map keys) (aref keys 1) calls) answers)))
    (let ((keys (vector 'prefix 'first))
          (map (make-sparse-keymap))
          (prefix (make-sparse-keymap))
          (calls 0))
      (define-key prefix [first] 'first-command)
      (define-key prefix [second] 'second-command)
      (define-key map [prefix]
        (list 'menu-item "Prefix" prefix
              :filter (lambda (definition)
                        (setq calls (1+ calls))
                        (aset keys 1 'second)
                        (garbage-collect)
                        definition)))
      (cl-letf (((symbol-function 'key-valid-p) (lambda (_) t))
                ((symbol-function 'key-parse)
                 (lambda (_) (garbage-collect) keys)))
        (push (list (lookup-key map ["C-x"]) (aref keys 1) calls) answers)))
    (nreverse answers)))
