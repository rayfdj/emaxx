(progn
  (require 'cl-lib)
  (let ((first (make-char-table 'translation-table nil))
        (second (make-char-table 'translation-table nil))
        (standard (make-char-table 'translation-table nil))
        (invalid (make-char-table 'translation-table nil)))
    (aset first 9731 233)
    (aset first 1114112 65)
    (aset second 233 65)
    (aset standard 9731 66)
    (aset invalid 9731 [65])
    (put 'runtime-coding-translation 'translation-table first)
    (dolist (definition
             (list (cons 'runtime-safe-direct first)
                   (cons 'runtime-safe-symbol 'runtime-coding-translation)
                   (cons 'runtime-safe-chain (list first second))
                   (cons 'runtime-safe-plain nil)
                   (cons 'runtime-safe-invalid invalid)))
      (define-coding-system (car definition) "Translation candidate control."
        :coding-type 'utf-8 :mnemonic ?R :charset-list '(ascii)
        :encode-translation-table (cdr definition)))
    (let ((codings '(runtime-safe-direct runtime-safe-symbol runtime-safe-chain
                    runtime-safe-plain runtime-safe-invalid)))
      (cl-labels
          ((membership (source)
             (let ((found (find-coding-systems-region-internal source nil)))
               (if (eq found t) 'all
                 (mapcar (lambda (coding) (not (null (memq coding found)))) codings)))))
        (list
         (let ((standard-translation-table-for-encode nil))
           (list (membership (string 9731))
                 (membership (string 1114112))
                 (membership (concat (string 9731) "a" (string 233 9731)))))
         (let ((standard-translation-table-for-encode second))
           (membership (string 9731)))
         (let ((standard-translation-table-for-encode standard))
           (membership (string 9731)))
         (let ((standard-translation-table-for-encode (list first second)))
           (membership (string 9731)))
         (let ((enable-character-translation nil)
               (standard-translation-table-for-encode standard))
           (membership (string 9731)))
         (progn
           (aset first 9731 65)
           (membership (string 9731)))
         (progn
           (put 'runtime-coding-translation 'translation-table second)
           (membership (string 9731)))
         (membership "ascii")
         (let ((coding-system-list '(utf-8-emacs utf-8 utf-8-emacs-unix)))
           (find-coding-systems-region-internal (string 9731) nil))
         (let ((coding-system-list '(utf-8 utf-8-emacs)))
           (find-coding-systems-region-internal (string 9731) nil '(utf-8)))
         (let ((coding-system-list nil))
           (find-coding-systems-region-internal (string 9731) nil)))))))
