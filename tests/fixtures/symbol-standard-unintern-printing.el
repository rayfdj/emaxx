(mapcar (lambda (suffix)
        (let* ((name (concat "detached-print-" suffix))
               (old (intern name)))
          (unintern old)
          (let ((new (intern name)) (print-gensym t))
            (list (string= (prin1-to-string old) (concat "#:" name))
                  (string= (prin1-to-string new) name)
                  (not (eq old new))))))
        (list "one" "λ-two"))
