(let* ((input-decode-map (make-sparse-keymap))
       (local-function-key-map (make-sparse-keymap))
       (key-translation-map (make-sparse-keymap))
       (map (copy-keymap minibuffer-local-map))
       (executing-kbd-macro t)
       (executing-kbd-macro-index 0)
       (unread-command-events (list 'f32 ?x 13))
       (shared-tail (cdr unread-command-events))
       (trace nil)
       (history-add-new-input nil))
  (define-key input-decode-map [f32]
    (lambda (_prompt)
      (push (eq unread-command-events shared-tail) trace)
      (setcar shared-tail ?z)
      (garbage-collect)
      [113]))
  (define-key map [13]
    (lambda ()
      (interactive)
      (push (list (this-command-keys-vector) (this-single-command-raw-keys)) trace)
      (insert "!")
      (exit-minibuffer)))
  (list (read-from-minibuffer "reader: " nil map) (nreverse trace)))
