(let ((cases (list (cons 'unibyte-128 (unibyte-string #x80))
                   (cons 'unibyte-255 (unibyte-string #xff))
                   (cons 'byte8-128 (string #x3fff80))
                   (cons 'byte8-255 (string #x3fffff))
                   (cons 'unicode-128 (string #x80))
                   (cons 'private-use-128 (string #xe080))
                   (cons 'ascii-unibyte (unibyte-string ?A))
                   (cons 'ascii-multibyte (string-to-multibyte "A"))))
      (result nil))
  (dolist (left cases)
    (dolist (right cases)
      (let ((a (copy-sequence (cdr left)))
            (b (copy-sequence (cdr right))))
        (put-text-property 0 1 'comparison-marker 'same-property a)
        (put-text-property 0 1 'comparison-marker 'same-property b)
        (push (list (car left) (car right)
                    (equal a b)
                    (equal-including-properties a b)
                    (string-equal a b))
              result))))
  (nreverse result))
